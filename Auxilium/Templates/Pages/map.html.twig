{% extends "/Bases/StandardWebPage.html.twig" %}

{% block head_assets %}
    {{ parent() }}
{% endblock %}

{% block content %}
    <div>
    <div class="inner-content">
        <div class="navigation-breadcrumb-container">
            <a class="navigation-breadcrumb" href="/dashboard">{{ "home" | uihdg }}</a>
            <a class="navigation-breadcrumb" href="/console">{{ "auxilium_console" | uihdg }}</a>
        </div>

        <h1><span class="inline-icon-shift-left inline-icon-low-margin terminal-icon"></span>{{ "map" | uihdg }}</h1>

        <script src="https://unpkg.com/vis-network@9.1.2/dist/vis-network.min.js"></script>
        <link href="https://unpkg.com/vis-network@9.1.2/dist/vis-network.min.css" rel="stylesheet" />
        <style>
            #graph {
                width: 100%;
                height: 600px;
                border: 1px solid lightgray;
            }
        </style>

        <div id="graph"></div>


        <script>
            const nodes = new vis.DataSet([
                {% for userDetails in all_users %}
                { id: '{{ userDetails.ID }}', label: '{{ userDetails.DisplayName }}', group: 'person' },
                {% endfor %}
                {% for caseDetails in all_cases %}
                { id: '{{ caseDetails.ID }}', label: '{{ caseDetails.Title }}', group: 'case' },
                {% endfor %}
            ]);

            const edges = new vis.DataSet([
                {% for linkDetails in links %}
                { from: '{{ linkDetails.From }}', to: '{{ linkDetails.To }}', label: '{{ linkDetails.Label }}' },
                {% endfor %}
            ]);

            const container = document.getElementById('graph');
            const data = { nodes, edges };
            const options = {
                nodes: {
                    shape: 'dot',
                    size: 16,
                    font: { size: 14 }
                },
                edges: {
                    arrows: 'to',
                    font: { align: 'middle' }
                },
                physics: {
                    enabled: true,
                    solver: 'forceAtlas2Based'
                },
                groups: {
                    case: { color: { background: '#FFD700' }, shape: 'box' },
                    person: { color: { background: '#87CEEB' } }
                }
            };

            const network = new vis.Network(container, data, options);

            network.on("click", function (params) {
                if (params.nodes.length) {
                    window.location = "/graph/~" + nodes.get(params.nodes[0]).id.replace("{", "").replace("}", "");
                }
            });
        </script>
    </div>
</div>
{% endblock %}
