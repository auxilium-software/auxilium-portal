<?xml version="1.0" encoding="utf-8" ?>
<auxForm>
    <id>Survey-ScreeningUnmetLegalNeedsInVeterans-ProfessionalsAndCaseworkers</id>
    <title>
        <translation xml:lang="en-GB">Screening Unmet Legal Needs in Veterans - Professionals and Caseworkers</translation>
    </title>
    <subtitle>
        <translation xml:lang="en-GB">This screening tool is meant to explore whether a veteran has unmet legal issues, whether they realise it or not. You should submit the form whether you or the veteran need help or not.</translation>
    </subtitle>
    <useReCAPTCHA>true</useReCAPTCHA>
    <requireAuthentication>false</requireAuthentication>
    <showReviewPage>true</showReviewPage>





    <pages>
        <page>
            <id>organisation_details</id>
            <title>
                <translation xml:lang="en-GB">Organisation Details</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>name_of_organisation_referring</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Name of organisation referring</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>when_did_you_first_start_to_have_help_from_referring_organisation</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">When did you first start to have help from the referring
                            organisation?
                        </translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>are_you_completing_this_form_as_part_of_a_drop_in</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>5</rows>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Are you completing this form as part of a drop in?</translation>
                    </primaryLabel>
                    <secondaryLabel>
                        <translation xml:lang="en-GB">If so, please tell us where your drop in is located.</translation>
                    </secondaryLabel>
                </component>
            </components>
        </page>


        <page>
            <id>your_details</id>
            <title>
                <translation xml:lang="en-GB">Your Details</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>your_year_of_birth</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Your year of birth.</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>your_gender</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Your gender</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>are_you_employed</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Are you employed?</translation>
                    </primaryLabel>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Yes</translation>
                            </primaryLabel>
                            <value>YES</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No</translation>
                            </primaryLabel>
                            <value>NO</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No answer</translation>
                            </primaryLabel>
                            <value>NO_ANSWER</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>


        <page>
            <id>do_any_of_the_below_apply_to_you</id>
            <title>
                <translation xml:lang="en-GB">Do any of the below apply to you?</translation>
            </title>
            <subtitle>
                <translation xml:lang="en-GB">You can click more than one answer</translation>
            </subtitle>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>do_any_of_the_below_apply_to_you</id>
                    <type>CHECKBOX_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Do any of the below apply to you?</translation>
                    </primaryLabel>
                    <haveOtherOption>true</haveOtherOption>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I have been injured in the armed forces</translation>
                            </primaryLabel>
                            <value>I have been injured in the armed forces</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I am being stopped from having a relationship with my child or children who are under 16</translation>
                            </primaryLabel>
                            <value>I am being stopped from having a relationship with my child or children who are under 16</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I have to go to court soon</translation>
                            </primaryLabel>
                            <value>I have to go to court soon</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I have experienced domestic violence or have been accused of domestic violence</translation>
                            </primaryLabel>
                            <value>I have experienced domestic violence or have been accused of domestic violence</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I am separating from my partner or spouse, or am afraid this might happen soon</translation>
                            </primaryLabel>
                            <value>I am separating from my partner or spouse, or am afraid this might happen soon</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I have been arrested or accused of something and I am afraid of what might happen
                                </translation>
                            </primaryLabel>
                            <value>I have been arrested or accused of something and I am afraid of what might happen</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">A company is sending me threatening letters and I don't know what to do</translation>
                            </primaryLabel>
                            <value>A company is sending me threatening letters and I don't know what to do</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I might become homeless or am being made homeless</translation>
                            </primaryLabel>
                            <value>I might become homeless or am being made homeless</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I have made a complaint about someone or something</translation>
                            </primaryLabel>
                            <value>I have made a complaint about someone or something</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I have another problem</translation>
                            </primaryLabel>
                            <value>I have another problem</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No, I do not believe I currently have any issues that I
                                    need help with
                                </translation>
                            </primaryLabel>
                            <value>No, I do not believe I currently have any issues that I need help with</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>


        <page>
            <id>issue_details</id>
            <title>
                <translation xml:lang="en-GB">Issue Details</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>when_did_the_issues_start</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">When did the issue / the issues start?</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>have_you_had_legal_advice_on_the_issue</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Have you had legal advice on the issue?</translation>
                    </primaryLabel>
                    <secondaryLabel>
                        <translation xml:lang="en-GB">If multiple please include all you have gotten legal advice for.</translation>
                    </secondaryLabel>
                </component>
            </components>
        </page>


        <page>
            <id>did_you_know</id>
            <title>
                <translation xml:lang="en-GB">Did you know?</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>did_you_know_that_all_of_these_are_considered_legal_issues_you_could_get_legal_advice_for</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Did you know that all of these are considered legal issues you could get legal advice for?</translation>
                    </primaryLabel>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Yes</translation>
                            </primaryLabel>
                            <value>YES</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No</translation>
                            </primaryLabel>
                            <value>NO</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No answer</translation>
                            </primaryLabel>
                            <value>NO_ANSWER</value>
                        </option>
                    </options>
                </component>
                <component>
                    <id>if_you_said_no_which_ones_didnt_you_know_counted_as_potential_legal_issues</id>
                    <type>TEXT_FIELD</type>
                    <required>false</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">If you said no, which ones didn't you know counted as potential
                            legal issues?
                        </translation>
                    </primaryLabel>
                    <secondaryLabel/>
                </component>
            </components>
        </page>


        <page>
            <id>issue_details</id>
            <title>
                <translation xml:lang="en-GB">Issue Details</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>would_you_like_to_talk_in_confidence_with_a_legal_charity_about_it_free_of_charge</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Would you like to talk in confidence with a legal charity about it, free of charge?</translation>
                    </primaryLabel>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Yes</translation>
                            </primaryLabel>
                            <value>YES</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No - I don't think I need this service</translation>
                            </primaryLabel>
                            <value>NO_DONT_NEED_SERVICE</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No - I don't think I need this service, but I think it would help other veterans</translation>
                            </primaryLabel>
                            <value>NO_DONT_NEED_SERVICE_BUT_MIGHT_HELP_OTHERS</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">No answer</translation>
                            </primaryLabel>
                            <value>NO_ANSWER</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>


    </pages>










    <reviewPage>
        <components>
            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Organisation Details</translation>
                </value>
                <jumpToPage>organisation_details</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Name of organisation referring</translation>
                        </key>
                        <value>$formData["name_of_organisation_referring"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">When did you first start to have help from the referring organisation?</translation>
                        </key>
                        <value>$formData["when_did_you_first_start_to_have_help_from_referring_organisation"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Are you completing this form as part of a drop in?</translation>
                        </key>
                        <value>$formData["are_you_completing_this_form_as_part_of_a_drop_in"]</value>
                    </item>
                </dictionary>
            </component>

            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Your Details</translation>
                </value>
                <jumpToPage>your_details</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Your year of birth</translation>
                        </key>
                        <value>$formData["your_year_of_birth"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Your gender</translation>
                        </key>
                        <value>$formData["your_gender"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Are you employed?</translation>
                        </key>
                        <value>$formData["are_you_employed"]</value>
                    </item>
                </dictionary>
            </component>

            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Issues That Apply</translation>
                </value>
                <jumpToPage>do_any_of_the_below_apply_to_you</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Do any of the below apply to you?</translation>
                        </key>
                        <value>do_any_of_the_below_apply_to_you</value>
                    </item>
                </dictionary>
            </component>

            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Issue Details</translation>
                </value>
                <jumpToPage>issue_details</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">When did the issue / the issues start?</translation>
                        </key>
                        <value>$formData["when_did_the_issues_start"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Have you had legal advice on the issue?</translation>
                        </key>
                        <value>$formData["have_you_had_legal_advice_on_the_issue"]</value>
                    </item>
                </dictionary>
            </component>

            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Awareness</translation>
                </value>
                <jumpToPage>did_you_know</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Did you know that all of these are considered legal issues you could get legal advice for?</translation>
                        </key>
                        <value>$formData["did_you_know_that_all_of_these_are_considered_legal_issues_you_could_get_legal_advice_for"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">If you said no, which ones didn't you know counted as potential legal issues?</translation>
                        </key>
                        <value>$formData["if_you_said_no_which_ones_didnt_you_know_counted_as_potential_legal_issues"]</value>
                    </item>
                </dictionary>
            </component>

            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Next Steps</translation>
                </value>
                <jumpToPage>issue_details</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Would you like to talk in confidence with a legal charity about it free of charge?</translation>
                        </key>
                        <value>$formData["would_you_like_to_talk_in_confidence_with_a_legal_charity_about_it_free_of_charge"]</value>
                    </item>
                </dictionary>
            </component>
        </components>
    </reviewPage>









    <submissionActions>
        <apiRequest>
            <executeIf>true</executeIf>
            <endpoint>/api/v3/surveys/screening-unmet-legal-needs-in-veterans-for-professionals-and-caseworkers</endpoint>
            <method>POST</method>
            <payload>
                <name_of_organisation>$formData["name_of_organisation_referring"]</name_of_organisation>
                <start_date>$formData["when_did_you_first_start_to_have_help_from_referring_organisation"]</start_date>
                <drop_in_location>$formData["are_you_completing_this_form_as_part_of_a_drop_in"]</drop_in_location>

                <year_of_birth>$formData["your_year_of_birth"]</year_of_birth>
                <gender>$formData["your_gender"]</gender>
                <employed>$formData["are_you_employed"]</employed>

                <issues_that_apply>$formData["do_any_of_the_below_apply_to_you"]</issues_that_apply>

                <when_issues_started>$formData["when_did_the_issues_start"]</when_issues_started>
                <had_legal_advice>$formData["have_you_had_legal_advice_on_the_issue"]</had_legal_advice>

                <knew_about_legal_issues>$formData["did_you_know_that_all_of_these_are_considered_legal_issues_you_could_get_legal_advice_for"]</knew_about_legal_issues>
                <which_didnt_know>$formData["if_you_said_no_which_ones_didnt_you_know_counted_as_potential_legal_issues"]</which_didnt_know>

                <wants_legal_charity_help>$formData["would_you_like_to_talk_in_confidence_with_a_legal_charity_about_it_free_of_charge"]</wants_legal_charity_help>
            </payload>
        </apiRequest>
    </submissionActions>
    <afterSubmissionRedirect>
        <target>/</target>
    </afterSubmissionRedirect>
</auxForm>
