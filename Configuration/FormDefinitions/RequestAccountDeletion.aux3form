<?xml version="1.0" encoding="utf-8" ?>
<auxForm>
    <id>RequestAccountDeletion</id>
    <title>Request Account Deletion</title>
    <subtitle>This form will guide you through requesting the deletion of your account.</subtitle>
    <useReCAPTCHA>true</useReCAPTCHA>
    <requireAuthentication>true</requireAuthentication>
    <showReviewPage>true</showReviewPage>





    <pages>
        <page>
            <id>reason</id>
            <title>Reason</title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>reason</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>4</rows>
                    <required>false</required>
                    <primaryLabel>Reason (optional)</primaryLabel>
                </component>
            </components>
        </page>

        <page>
            <id>current_password</id>
            <title>Current Password</title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>current_password</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Current Password</primaryLabel>
                </component>
            </components>
        </page>
    </pages>




    <reviewPage>
        <components>
            <component>
                <type>PARAGRAPH</type>
                <title>Reason</title>
                <value>$formData["reason"]</value>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>Password</key>
                        <value>[REDACTED]</value>
                    </item>
                </dictionary>
            </component>
        </components>
    </reviewPage>










    <submissionActions>
        <apiRequest>
            <executeIf>true</executeIf>
            <endpoint>/api/v3/me/request-account-deletion</endpoint>
            <method>POST</method>
            <payload>
                <reason>$formData["reason"]</reason>
                <currentPasswordSha512>$formData["current_password"]</currentPasswordSha512>
            </payload>
        </apiRequest>
    </submissionActions>
    <afterSubmissionRedirect>
        <target>/me</target>
    </afterSubmissionRedirect>
</auxForm>
