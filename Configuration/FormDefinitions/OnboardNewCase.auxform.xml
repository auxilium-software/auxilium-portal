<?xml version="1.0" encoding="utf-8" ?>
<auxForm>
    <id>OnboardNewCase</id>
    <title>Onboard a New Case</title>
    <subtitle>This form will guide you through creating an account and starting a new case with us.</subtitle>
    <useReCAPTCHA>true</useReCAPTCHA>
    <requireAuthentication>false</requireAuthentication>





    <pages>
        <page>
            <id>who_is_case_about</id>
            <title>Which best describes your situation?</title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>on_behalf_of</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>I am applying for help myself.</primaryLabel>
                            <value>MYSELF</value>
                        </option>
                        <option>
                            <primaryLabel>I am helping someone else with their application.</primaryLabel>
                            <secondaryLabel>I need ongoing access to manage the case on behalf of someone else.</secondaryLabel>
                            <value>SOMEONE_ELSE_MANAGED</value>
                        </option>
                        <option>
                            <primaryLabel>I am referring someone.</primaryLabel>
                            <secondaryLabel>I need to make first contact on behalf of someone else, but will not be managing this case on an ongoing basis.</secondaryLabel>
                            <value>SOMEONE_ELSE</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>





        <page>
            <id>consent</id>
            <title>Data processing consent</title>
            <description>
                By completing these questions you consent to us processing your data,
                opening a case and considering the information that you have provided.

                Please confirm that you are happy for your data to be used for these purposes,
                and that you consent to us contacting you once your form has been received.

                Alternatively, confirm that your service user or beneficiary consents to the above.
            </description>
            <renderIf>equals($formData["on_behalf_of"],"MYSELF")</renderIf>
            <components>
                <component>
                    <id>data_processing_consent</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>I consent</primaryLabel>
                            <value>CONSENT_GIVEN</value>
                        </option>
                        <option>
                            <primaryLabel>I do not consent</primaryLabel>
                            <value>NO_CONSENT</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>
        <page>
            <id>consent</id>
            <title>Data processing consent</title>
            <description>
                By completing these questions you consent to us processing your data,
                opening a case and considering the information that you have provided.

                Please confirm that you are happy for your data to be used for these purposes,
                and that you consent to us contacting you once your form has been received.

                Alternatively, confirm that your service user or beneficiary consents to the above.
            </description>
            <renderIf>
                or(
                    equals($formData["on_behalf_of"],"SOMEONE_ELSE"),
                    equals($formData["on_behalf_of"],"SOMEONE_ELSE_MANAGED")
                )
            </renderIf>
            <components>
                <component>
                    <id>data_processing_consent</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>They consent</primaryLabel>
                            <value>CONSENT_GIVEN</value>
                        </option>
                        <option>
                            <primaryLabel>They do not consent</primaryLabel>
                            <value>NO_CONSENT</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>





        <page>
            <id>consent_not_given</id>
            <title>Data processing consent is required</title>
            <description>
                Data consent is required, sorry lol.
            </description>
            <renderIf>equals($formData["data_processing_consent"],"NO_CONSENT")</renderIf>
            <abandonForm>true</abandonForm>
            <components>
            </components>
        </page>





        <page>
            <id>contact_details</id>
            <title>Your contact details</title>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    equals($formData["on_behalf_of"],"MYSELF")
                )
            </renderIf>
            <components>
                <component>
                    <id>full_name</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Full Name</primaryLabel>
                </component>
                <component>
                    <id>telephone_number</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Telephone Number</primaryLabel>
                </component>
                <component>
                    <id>full_address</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>5</rows>
                    <required>true</required>
                    <primaryLabel>Full Address, County, and Postcode</primaryLabel>
                </component>
            </components>
        </page>
        <page>
            <id>contact_details_for_individual_applying_behalf_of</id>
            <title>Contact details for individual you are applying on behalf of</title>
            <description>Please enter as the contact details for the person you are applying on behalf of.</description>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    or(
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE"),
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE_MANAGED")
                    )
                )
            </renderIf>
            <components>
                <component>
                    <id>full_name</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Full Name</primaryLabel>
                </component>
                <component>
                    <id>telephone_number</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Telephone Number</primaryLabel>
                </component>
                <component>
                    <id>full_address</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>5</rows>
                    <required>true</required>
                    <primaryLabel>Full Address, County, and Postcode</primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>about_you</id>
            <title>About You</title>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    equals($formData["on_behalf_of"],"MYSELF")
                )
            </renderIf>
            <components>
                <component>
                    <id>gender</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>Female</primaryLabel>
                            <value>female</value>
                        </option>
                        <option>
                            <primaryLabel>Male</primaryLabel>
                            <value>male</value>
                        </option>
                        <option>
                            <primaryLabel>Other</primaryLabel>
                            <value>other</value>
                        </option>
                    </options>
                </component>
                <component>
                    <id>ethnic_group</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Ethnic group</primaryLabel>
                </component>
                <component>
                    <id>date_of_birth</id>
                    <type>DATE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Date of birth</primaryLabel>
                </component>
                <component>
                    <id>how_did_you_find_out_about_our_service</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>4</rows>
                    <required>true</required>
                    <primaryLabel>How did you find out about our service?</primaryLabel>
                </component>
            </components>
        </page>
        <page>
            <id>about_individual_applying_behalf_of</id>
            <title>About individual you are applying on behalf of</title>
            <description>Please enter information for the person you are applying on behalf of.</description>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    or(
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE"),
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE_MANAGED")
                    )
                )
            </renderIf>
            <components>
                <component>
                    <id>gender</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>Female</primaryLabel>
                            <value>female</value>
                        </option>
                        <option>
                            <primaryLabel>Male</primaryLabel>
                            <value>male</value>
                        </option>
                        <option>
                            <primaryLabel>Other</primaryLabel>
                            <value>other</value>
                        </option>
                    </options>
                </component>
                <component>
                    <id>ethnic_group</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Ethnic group</primaryLabel>
                </component>
                <component>
                    <id>date_of_birth</id>
                    <type>DATE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Date of birth</primaryLabel>
                </component>
                <component>
                    <id>how_did_you_find_out_about_our_service</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>4</rows>
                    <required>true</required>
                    <primaryLabel>How did you find out about our service?</primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>login_details</id>
            <title>Login details</title>
            <renderIf>equals($formData["data_processing_consent"],"CONSENT_GIVEN")</renderIf>
            <components>
                <component>
                    <id>email_address</id>
                    <type>EMAIL_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Email Address</primaryLabel>
                </component>
                <component>
                    <id>raw_password</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Password</primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>case_details</id>
            <title>Case details</title>
            <renderIf>equals($formData["data_processing_consent"],"CONSENT_GIVEN")</renderIf>
            <components>
                <component>
                    <id>case_title</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>Case Title</primaryLabel>
                </component>
                <component>
                    <id>case_description</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>12</rows>
                    <required>true</required>
                    <primaryLabel>Case Description</primaryLabel>
                </component>
            </components>
        </page>
    </pages>










    <reviewPage>
        <components>
            <component>
                <type>SUBHEADING</type>
                <value>Beneficiary Details</value>
                <jumpToPage>who_is_case_about</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>User</key>
                        <value>$target</value>
                    </item>
                    <item>
                        <key>Full Name</key>
                        <value>$formData["full_name"]</value>
                    </item>
                    <item>
                        <key>Telephone Number</key>
                        <value>$formData["telephone_number"]</value>
                    </item>
                    <item>
                        <key>Full Address</key>
                        <value>$formData["full_address"]</value>
                    </item>
                </dictionary>
            </component>





            <component>
                <type>SUBHEADING</type>
                <value>Beneficiary Details</value>
                <jumpToPage>about_you</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>Gender</key>
                        <value>$formData["gender"]</value>
                    </item>
                    <item>
                        <key>Ethic Group</key>
                        <value>$formData["ethnic_group"]</value>
                    </item>
                    <item>
                        <key>Date of Birth</key>
                        <value>$formData["date_of_birth"]</value>
                    </item>
                </dictionary>
            </component>





            <component>
                <type>DESCRIPTION_LIST</type>
                <if>not(exists($target))</if>
                <dictionary>
                    <item>
                        <key>Full Name</key>
                        <value>$formData["full_name"]</value>
                    </item>
                </dictionary>
            </component>
            <component>
                <type>SUBHEADING</type>
                <value>Case Description</value>
                <jumpToPage>case_details</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>PARAGRAPH</type>
                <value>$formData["case_description"]</value>
                <if>true</if>
            </component>
        </components>
    </reviewPage>










    <submissionActions>
        <apiRequest>
            <executeIf>true</executeIf>
            <endpoint>/authentication/register</endpoint>
            <method>POST</method>
            <payload>
                <who_is_case_about>$formData["who_is_case_about"]</who_is_case_about>
                <consent_given>$formData["data_processing_consent"]</consent_given>
                <full_name>$formData["full_name"]</full_name>
                <telephone_number>$formData["telephone_number"]</telephone_number>
                <full_address>$formData["full_address"]</full_address>
                <gender>$formData["gender"]</gender>
                <ethnic_group>$formData["ethnic_group"]</ethnic_group>
                <date_of_birth>$formData["date_of_birth"]</date_of_birth>
                <how_did_you_find_out_about_our_service>$formData["how_did_you_find_out_about_our_service"]</how_did_you_find_out_about_our_service>
                <email_address>$formData["email_address"]</email_address>
                <raw_password>$formData["raw_password"]</raw_password>
                <title>$formData["case_title"]</title>
                <description>$formData["case_description"]</description>
            </payload>
        </apiRequest>
    </submissionActions>
    <afterSubmissionRedirect>
        <target>/login</target>
    </afterSubmissionRedirect>
</auxForm>
