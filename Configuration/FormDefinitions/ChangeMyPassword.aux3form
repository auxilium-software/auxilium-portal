<?xml version="1.0" encoding="utf-8" ?>
<auxForm>
    <id>ChangeMyPassword</id>
    <title>
        <translation xml:lang="en-GB">Change My Password</translation>
        <translation xml:lang="cy-GB">Newid fy Nghyfrinair</translation>
    </title>
    <subtitle>
        <translation xml:lang="en-GB">This form will guide you through changing your password.</translation>
        <translation xml:lang="cy-GB">Bydd y ffurflen hon yn eich tywys drwy newid eich cyfrinair.</translation>
    </subtitle>
    <useReCAPTCHA>true</useReCAPTCHA>
    <requireAuthentication>true</requireAuthentication>
    <showReviewPage>false</showReviewPage>





    <pages>
        <page>
            <id>current_password</id>
            <title>
                <translation xml:lang="en-GB">Password Change</translation>
                <translation xml:lang="cy-GB">Newid Cyfrinair</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>current_password</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Current Password</translation>
                        <translation xml:lang="cy-GB">Cyfrinair Cyfredol</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>
        <page>
            <id>new_password</id>
            <title>
                <translation xml:lang="en-GB">Password Change</translation>
                <translation xml:lang="cy-GB">Newid Cyfrinair</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>new_password</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">New Password</translation>
                        <translation xml:lang="cy-GB">Cyfrinair Newydd</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>new_password_confirm</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Confirm New Password</translation>
                        <translation xml:lang="cy-GB">Cadarnhau Cyfrinair Newydd</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>new_passwords_do_not_match</id>
            <title>
                <translation xml:lang="en-GB">New passwords do not match.</translation>
                <translation xml:lang="cy-GB">Nid yw’r cyfrineiriau newydd yn cyd-fynd.</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">The fields "New Password" and "Confirm New Password" must have the same content.</translation>
                <translation xml:lang="cy-GB">Rhaid i'r meysydd "Cyfrinair Newydd" a "Cadarnhau Cyfrinair Newydd" fod â'r un cynnwys.</translation>
            </description>
            <renderIf>not(equals($formData["new_password"],$formData["new_password_confirm"]))</renderIf>
            <abandonForm>true</abandonForm>
            <components>
            </components>
        </page>
        <page>
            <id>new_password_is_the_same_as_the_old_password</id>
            <title>
                <translation xml:lang="en-GB">Password conflict.</translation>
                <translation xml:lang="cy-GB">Cyfrinair yn gwrthdaro.</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">The new password may not be the same as the old password.</translation>
                <translation xml:lang="cy-GB">Ni all eich cyfrinair newydd fod yr un fath â'r cyfrinair blaenorol.</translation>
            </description>
            <renderIf>equals($formData["current_password"],$formData["new_password"])</renderIf>
            <abandonForm>true</abandonForm>
            <components>
            </components>
        </page>
    </pages>




    <reviewPage>
        <components>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Old Password</translation>
                            <translation xml:lang="cy-GB">Hen Gyfrinair</translation>
                        </key>
                        <value>[REDACTED]</value>
                    </item>
                </dictionary>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">New Password</translation>
                            <translation xml:lang="cy-GB">Cyfrinair Newydd</translation>
                        </key>
                        <value>[REDACTED]</value>
                    </item>
                </dictionary>
            </component>
        </components>
    </reviewPage>










    <submissionActions>
        <apiRequest>
            <executeIf>true</executeIf>
            <endpoint>/api/v3/me/change-password</endpoint>
            <method>POST</method>
            <payload>
                <currentPasswordSha512>$formData["current_password"]</currentPasswordSha512>
                <newPasswordSha512>$formData["new_password"]</newPasswordSha512>
            </payload>
        </apiRequest>
    </submissionActions>
    <afterSubmissionRedirect>
        <target>/logout</target>
    </afterSubmissionRedirect>
</auxForm>
