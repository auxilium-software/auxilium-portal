<?xml version="1.0" encoding="utf-8" ?>
<auxForm>
    <id>OnboardNewCase</id>
    <title>
        <translation xml:lang="en-GB">Onboard a New Case</translation>
        <translation xml:lang="cy-GB"></translation>
    </title>
    <subtitle>
        <translation xml:lang="en-GB">This form will guide you through creating an account and starting a new case with us.</translation>
        <translation xml:lang="cy-GB"></translation>
    </subtitle>
    <useReCAPTCHA>true</useReCAPTCHA>
    <requireAuthentication>false</requireAuthentication>
    <showReviewPage>true</showReviewPage>





    <pages>
        <page>
            <id>who_is_case_about</id>
            <title>
                <translation xml:lang="en-GB">Which best describes your situation?</translation>
                <translation xml:lang="cy-GB">Pa un sy'n disgrifio eich sefyllfa orau?</translation>
            </title>
            <renderIf>true</renderIf>
            <components>
                <component>
                    <id>on_behalf_of</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I am applying for help myself.</translation>
                                <translation xml:lang="cy-GB">Rwy'n gwneud cais am gymorth fy hun.</translation>
                            </primaryLabel>
                            <value>MYSELF</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I am helping someone else with their application.</translation>
                                <translation xml:lang="cy-GB">Rwy'n helpu rhywun arall gyda'u cais.</translation>
                            </primaryLabel>
                            <secondaryLabel>
                                <translation xml:lang="en-GB">I need ongoing access to manage the case on behalf of someone else.</translation>
                                <translation xml:lang="cy-GB">Mae angen mynediad parhaus arnaf i reoli'r achos ar ran rhywun arall.</translation>
                            </secondaryLabel>
                            <value>SOMEONE_ELSE_MANAGED</value>
                        </option>
                        <!--
                        <option>
                            <primaryLabel>I am referring someone.</primaryLabel>
                            <secondaryLabel>I need to make first contact on behalf of someone else, but will not be managing this case on an ongoing basis.</secondaryLabel>
                            <value>SOMEONE_ELSE</value>
                        </option>
                        -->
                    </options>
                </component>
            </components>
        </page>





        <page>
            <id>consent</id>
            <title>
                <translation xml:lang="en-GB">Data processing consent</translation>
                <translation xml:lang="cy-GB">Caniatâd prosesu data</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">By completing these questions you consent to us processing your data,
                    opening a case and considering the information that you have provided.

                    Please confirm that you are happy for your data to be used for these purposes,
                    and that you consent to us contacting you once your form has been received.

                    Alternatively, confirm that your service user or beneficiary consents to the above.</translation>
                <translation xml:lang="cy-GB">Trwy lenwi'r cwestiynau hyn rydych chi'n cydsynio i ni brosesu eich data, agor achos ac ystyried y wybodaeth rydych chi wedi'i darparu.

                    Cadarnhewch eich bod yn hapus i'ch data gael ei ddefnyddio at y dibenion hyn, a'ch bod yn cydsynio i ni gysylltu â chi ar ôl i'ch ffurflen ddod i law.

                    Fel arall, cadarnhewch fod defnyddiwr y gwasanaeth neu fuddiolwr yn cydsynio i'r uchod.</translation>
            </description>
            <renderIf>equals($formData["on_behalf_of"],"MYSELF")</renderIf>
            <components>
                <component>
                    <id>data_processing_consent</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I consent</translation>
                                <translation xml:lang="cy-GB">Rwy'n cydsynio</translation>
                            </primaryLabel>
                            <value>CONSENT_GIVEN</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">I do not consent</translation>
                                <translation xml:lang="cy-GB">Nid wyf yn cydsynio </translation>
                            </primaryLabel>
                            <value>NO_CONSENT</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>
        <page>
            <id>consent</id>
            <title>
                <translation xml:lang="en-GB">Data processing consent</translation>
                <translation xml:lang="cy-GB">OwO</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">By completing these questions you consent to us processing your data,
                    opening a case and considering the information that you have provided.

                    Please confirm that you are happy for your data to be used for these purposes,
                    and that you consent to us contacting you once your form has been received.

                    Alternatively, confirm that your service user or beneficiary consents to the above.</translation>
                <translation xml:lang="cy-GB">Trwy lenwi'r cwestiynau hyn rydych chi'n cydsynio i ni brosesu eich data, agor achos ac ystyried y wybodaeth rydych chi wedi'i darparu.

                    Cadarnhewch eich bod yn hapus i'ch data gael ei ddefnyddio at y dibenion hyn,
                    a'ch bod yn cydsynio i ni gysylltu â chi ar ôl i'ch ffurflen ddod i law.

                    Fel arall, cadarnhewch fod defnyddiwr y gwasanaeth neu fuddiolwr yn cydsynio i'r uchod.</translation>
            </description>
            <renderIf>
                or(
                equals($formData["on_behalf_of"],"SOMEONE_ELSE"),
                equals($formData["on_behalf_of"],"SOMEONE_ELSE_MANAGED")
                )
            </renderIf>
            <components>
                <component>
                    <id>data_processing_consent</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">They consent</translation>
                                <translation xml:lang="cy-GB">Maen nhw'n cydsynio</translation>
                            </primaryLabel>
                            <value>CONSENT_GIVEN</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">They do not consent</translation>
                                <translation xml:lang="cy-GB">Nid ydynt yn cydsynio </translation>
                            </primaryLabel>
                            <value>NO_CONSENT</value>
                        </option>
                    </options>
                </component>
            </components>
        </page>





        <page>
            <id>consent_not_given</id>
            <title>
                <translation xml:lang="en-GB">Data processing consent is required</translation>
                <translation xml:lang="cy-GB">Mae angen caniatâd prosesu data</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">Data processing consent is required for case creation.</translation>
                <translation xml:lang="cy-GB">Mae angen caniatâd prosesu data i greu achos.</translation>
            </description>
            <renderIf>equals($formData["data_processing_consent"],"NO_CONSENT")</renderIf>
            <abandonForm>true</abandonForm>
            <components>
            </components>
        </page>





        <page>
            <id>contact_details</id>
            <title>
                <translation xml:lang="en-GB">Your contact details</translation>
                <translation xml:lang="cy-GB"></translation>
            </title>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    equals($formData["on_behalf_of"],"MYSELF")
                )
            </renderIf>
            <components>
                <component>
                    <id>full_name</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Full Name</translation>
                        <translation xml:lang="cy-GB">Enw Llawn</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>telephone_number</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Telephone Number</translation>
                        <translation xml:lang="cy-GB">Rhif ffôn</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>full_address</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>5</rows>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Full Address, County, and Postcode</translation>
                        <translation xml:lang="cy-GB">Cyfeiriad Llawn, Sir a Chod Post</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>
        <page>
            <id>contact_details_for_individual_applying_behalf_of</id>
            <title>
                <translation xml:lang="en-GB">Contact details for individual you are applying on behalf of</translation>
                <translation xml:lang="cy-GB">Manylion cyswllt ar gyfer unigolyn rydych chi'n gwneud cais ar eu rhan</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">Please enter as the contact details for the person you are applying on behalf of.</translation>
                <translation xml:lang="cy-GB">Rhowch fanylion cyswllt ar gyfer unigolyn rydych chi'n gwneud cais ar eu rhan</translation>
            </description>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    or(
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE"),
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE_MANAGED")
                    )
                )
            </renderIf>
            <components>
                <component>
                    <id>full_name</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Full Name</translation>
                        <translation xml:lang="cy-GB">Enw Llawn</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>telephone_number</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Telephone Number</translation>
                        <translation xml:lang="cy-GB">Rhif ffôn</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>full_address</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>5</rows>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Full Address, County, and Postcode</translation>
                        <translation xml:lang="cy-GB">Cyfeiriad Llawn, Sir a Chod Post</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>about_you</id>
            <title>
                <translation xml:lang="en-GB">About You</translation>
                <translation xml:lang="cy-GB"></translation>
            </title>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    equals($formData["on_behalf_of"],"MYSELF")
                )
            </renderIf>
            <components>
                <component>
                    <id>gender</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Female</translation>
                                <translation xml:lang="cy-GB">Benyw</translation>
                            </primaryLabel>
                            <value>female</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Male</translation>
                                <translation xml:lang="cy-GB">Gwryw</translation>
                            </primaryLabel>
                            <value>male</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Other</translation>
                                <translation xml:lang="cy-GB">Arall </translation>
                            </primaryLabel>
                            <value>other</value>
                        </option>
                    </options>
                </component>
                <component>
                    <id>ethnic_group</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Ethnic group</translation>
                        <translation xml:lang="cy-GB">Grŵp Ethnig </translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>date_of_birth</id>
                    <type>DATE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Date of birth</translation>
                        <translation xml:lang="cy-GB">Dyddiad geni</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>how_did_you_find_out_about_our_service</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>4</rows>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">How did you find out about our service?</translation>
                        <translation xml:lang="cy-GB">Sut glywsoch chi am ein gwasanaeth?</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>
        <page>
            <id>about_individual_applying_behalf_of</id>
            <title>
                <translation xml:lang="en-GB">About individual you are applying on behalf of</translation>
                <translation xml:lang="cy-GB">Ynglŷn â’r unigolyn rydych chi'n gwneud cais ar eu rhan</translation>
            </title>
            <description>
                <translation xml:lang="en-GB">Please enter information for the person you are applying on behalf of.</translation>
                <translation xml:lang="cy-GB">Rhowch wybodaeth ar gyfer unigolyn rydych chi'n gwneud cais ar eu rhan</translation>
            </description>
            <renderIf>
                and(
                    equals($formData["data_processing_consent"],"CONSENT_GIVEN"),
                    or(
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE"),
                        equals($formData["on_behalf_of"],"SOMEONE_ELSE_MANAGED")
                    )
                )
            </renderIf>
            <components>
                <component>
                    <id>gender</id>
                    <type>CHOICE_FIELD</type>
                    <required>true</required>
                    <options>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Female</translation>
                                <translation xml:lang="cy-GB">Benyw</translation>
                            </primaryLabel>
                            <value>female</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Male</translation>
                                <translation xml:lang="cy-GB">Gwryw</translation>
                            </primaryLabel>
                            <value>male</value>
                        </option>
                        <option>
                            <primaryLabel>
                                <translation xml:lang="en-GB">Other</translation>
                                <translation xml:lang="cy-GB">Arall </translation>
                            </primaryLabel>
                            <value>other</value>
                        </option>
                    </options>
                </component>
                <component>
                    <id>ethnic_group</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Ethnic group</translation>
                        <translation xml:lang="cy-GB">Grŵp Ethnig </translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>date_of_birth</id>
                    <type>DATE_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Date of birth</translation>
                        <translation xml:lang="cy-GB">Dyddiad geni</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>how_did_you_find_out_about_our_service</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>4</rows>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">How did you find out about our service?</translation>
                        <translation xml:lang="cy-GB">Sut glywsoch chi am ein gwasanaeth?</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>login_details</id>
            <title>
                <translation xml:lang="en-GB">Create your Login details</translation>
                <translation xml:lang="cy-GB"></translation>
            </title>
            <renderIf>equals($formData["data_processing_consent"],"CONSENT_GIVEN")</renderIf>
            <components>
                <component>
                    <id>email_address</id>
                    <type>EMAIL_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Email Address</translation>
                        <translation xml:lang="cy-GB">Cyfeiriad e-bost</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>email_address_confirm</id>
                    <type>EMAIL_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Confirm Email Address</translation>
                        <translation xml:lang="cy-GB"></translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>password</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Password</translation>
                        <translation xml:lang="cy-GB">Cyfrinair</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>password_confirm</id>
                    <type>PASSWORD_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Confirm Password</translation>
                        <translation xml:lang="cy-GB">Cadarnhau Cyfrinair</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>





        <page>
            <id>email_addresses_not_equal</id>
            <title>
                <translation xml:lang="en-GB">Email addresses do not match.</translation>
                <translation xml:lang="cy-GB"></translation>
            </title>
            <description>
                <translation xml:lang="en-GB">Please ensure you enter the same email address into both fields.</translation>
                <translation xml:lang="cy-GB"></translation>
            </description>
            <renderIf>not(equals($formData["email_address"],$formData["email_address_confirm"]))</renderIf>
            <abandonForm>true</abandonForm>
            <components>
            </components>
        </page>
        <page>
            <id>passwords_not_equal</id>
            <title>
                <translation xml:lang="en-GB">Passwords do not match.</translation>
                <translation xml:lang="cy-GB"></translation>
            </title>
            <description>
                <translation xml:lang="en-GB">Please ensure you enter the same password into both fields.</translation>
                <translation xml:lang="cy-GB"></translation>
            </description>
            <renderIf>not(equals($formData["password"],$formData["password_confirm"]))</renderIf>
            <abandonForm>true</abandonForm>
            <components>
            </components>
        </page>





        <page>
            <id>case_details</id>
            <title>
                <translation xml:lang="en-GB">Case details</translation>
                <translation xml:lang="cy-GB">Manylion yr achos</translation>
            </title>
            <renderIf>equals($formData["data_processing_consent"],"CONSENT_GIVEN")</renderIf>
            <components>
                <component>
                    <id>case_title</id>
                    <type>TEXT_FIELD</type>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Case Title</translation>
                        <translation xml:lang="cy-GB">Teitl yr achos</translation>
                    </primaryLabel>
                </component>
                <component>
                    <id>case_description</id>
                    <type>LARGE_TEXT_FIELD</type>
                    <rows>12</rows>
                    <required>true</required>
                    <primaryLabel>
                        <translation xml:lang="en-GB">Case Description</translation>
                        <translation xml:lang="cy-GB">Disgrifiad o'r Achos</translation>
                    </primaryLabel>
                </component>
            </components>
        </page>
    </pages>










    <reviewPage>
        <components>
            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Beneficiary Details</translation>
                    <translation xml:lang="cy-GB">Manylion y Buddiolwr</translation>
                </value>
                <jumpToPage>who_is_case_about</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">User</translation>
                            <translation xml:lang="cy-GB">Defnyddiwr</translation>
                        </key>
                        <value>$target</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Full Name</translation>
                            <translation xml:lang="cy-GB">Enw Llawn</translation>
                        </key>
                        <value>$formData["full_name"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Telephone Number</translation>
                            <translation xml:lang="cy-GB">Rhif ffôn</translation>
                        </key>
                        <value>$formData["telephone_number"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Full Address</translation>
                            <translation xml:lang="cy-GB">Cyfeiriad Llawn</translation>
                        </key>
                        <value>$formData["full_address"]</value>
                    </item>
                </dictionary>
            </component>





            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Beneficiary Details</translation>
                    <translation xml:lang="cy-GB">Manylion y Buddiolwr</translation>
                </value>
                <jumpToPage>about_you</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>DESCRIPTION_LIST</type>
                <if>true</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Gender</translation>
                            <translation xml:lang="cy-GB">Rhywedd</translation>
                        </key>
                        <value>$formData["gender"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Ethic Group</translation>
                            <translation xml:lang="cy-GB">Grŵp Ethnig</translation>
                        </key>
                        <value>$formData["ethnic_group"]</value>
                    </item>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Date of Birth</translation>
                            <translation xml:lang="cy-GB">Dyddiad geni</translation>
                        </key>
                        <value>$formData["date_of_birth"]</value>
                    </item>
                </dictionary>
            </component>





            <component>
                <type>DESCRIPTION_LIST</type>
                <if>not(exists($target))</if>
                <dictionary>
                    <item>
                        <key>
                            <translation xml:lang="en-GB">Full Name</translation>
                            <translation xml:lang="cy-GB">Enw Llawn</translation>
                        </key>
                        <value>$formData["full_name"]</value>
                    </item>
                </dictionary>
            </component>
            <component>
                <type>SUBHEADING</type>
                <value>
                    <translation xml:lang="en-GB">Case Description</translation>
                    <translation xml:lang="cy-GB">Disgrifiad o'r Achos</translation>
                </value>
                <jumpToPage>case_details</jumpToPage>
                <if>true</if>
            </component>
            <component>
                <type>PARAGRAPH</type>
                <value>$formData["case_description"]</value>
                <if>true</if>
            </component>
        </components>
    </reviewPage>










    <submissionActions>
        <apiRequest>
            <executeIf>true</executeIf>
            <endpoint>/api/v3/authentication/register</endpoint>
            <method>POST</method>
            <payload>
                <who_is_case_about>$formData["who_is_case_about"]</who_is_case_about>
                <dataProcessingConsent>$formData["data_processing_consent"]</dataProcessingConsent>
                <fullName>$formData["full_name"]</fullName>
                <telephoneNumber>$formData["telephone_number"]</telephoneNumber>
                <fullAddress>$formData["full_address"]</fullAddress>
                <gender>$formData["gender"]</gender>
                <ethnicGroup>$formData["ethnic_group"]</ethnicGroup>
                <dateOfBirth>$formData["date_of_birth"]</dateOfBirth>
                <howDidYouFindOutAboutOurService>$formData["how_did_you_find_out_about_our_service"]</howDidYouFindOutAboutOurService>
                <onBehalfOf>$formData["on_behalf_of"]</onBehalfOf>
                <emailAddress>$formData["email_address"]</emailAddress>
                <passwordSha512>$formData["password"]</passwordSha512>
                <caseTitle>$formData["case_title"]</caseTitle>
                <caseDescription>$formData["case_description"]</caseDescription>
                <languagePreference>en-GB</languagePreference>
            </payload>
        </apiRequest>
    </submissionActions>
    <afterSubmissionRedirect>
        <target>/login</target>
    </afterSubmissionRedirect>
</auxForm>
