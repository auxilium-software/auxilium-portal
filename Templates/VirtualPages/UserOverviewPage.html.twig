{% extends "/Bases/StandardWebPage.html.twig" %}

{% block title %}{{ "user overview" | translate }}{% endblock %}

{% block content %}
    {% if _IS_ADMIN_ %}
        {#
        <code>
            {{ UserDetails|json_encode }}
        </code>
        #}
    {% endif %}

    <div>
        <div class="inner-content">
            <div class="navigation-breadcrumb-container">
                <a class="navigation-breadcrumb" href="/dashboard">{{ "Home" | translate }}</a>
                <a class="navigation-breadcrumb" href="/users">{{ "Users" | translate }}</a>
                <a class="navigation-breadcrumb" href="/users/{{ UserDetails.id }}">{{ "User Overview" | translate }}</a>
            </div>

            <h1>
                <span class="inline-icon-shift-left inline-icon-low-margin account-box-icon" title="User account"></span>
                {% if UserDetails.fullName %}
                    {{ UserDetails.fullName }}
                {% else %}
                    {{ "{" ~ UserDetails.id ~ "}" }}
                {% endif %}
            </h1>

            <div class="separator"></div>

            <div>
                <div id="main-content" class="reference-element"></div>

                <div class="left-preferential-box">

                    <div class="marked-section">
                        <h2>
                            {{ "Properties" | translate }}
                            <a href="javascript:void(0)"
                               class="inline-icon add-icon add-property-trigger"
                               data-type="PLAIN_TEXT,ENUM"
                               data-resource="/api/v3/users/{{ UserDetails.id }}/additional_properties/*"
                               data-group-id=""
                               title="{{ "Add Entry" | translate }}"
                            ></a>
                        </h2>
                        <br />
                        {% include '/Partials/GroupedPropertyList.html.twig' with {
                            '_sections': PropertySections,
                            '_subjectId': UserDetails.id,
                            '_managerClass': 'UserPropertyManager',
                            '_resource': '/api/v3/users/' ~ UserDetails.id ~ '/additional_properties/*',
                            '_addTypes': 'PLAIN_TEXT,ENUM',
                        } %}

                        <a href="javascript:toggle_hidden_box('ext_props');"><strong>{{ "Extended Properties" | translate }}</strong><span id="hidden_box_ext_props_toggle_button" class="inline-icon-low-margin inline-icon-shift-right expand-more-icon" style="display: none;"></span></a>
                        <div class="small-spacer"></div>
                        <div id="hidden_box_ext_props" class="logical-box">
                            <dl>
                                <dt>{{ "Object ID" | translate }}</dt>
                                <dd>{{ UserDetails.id }}</dd>

                                <dt>{{ "Created At" | translate }}</dt>
                                <dd>{{ UserDetails.createdAt | date("jS F Y, g:ia T") }}</dd>

                                <dt>{{ "Last Updated At" | translate }}</dt>
                                <dd>{{ UserDetails.lastUpdatedAt | date("jS F Y, g:ia T") }}</dd>
                            </dl>
                        </div>

                        <script>toggle_hidden_box("ext_props");</script>
                    </div>
                </div>

                <div class="right-preferential-box">
                    <div class="marked-section">
                        <h2>{{ "Files" | translate }}
                            <a href="javascript:{const cm = new FileManager('USER', '{{ UserDetails.id }}'); cm.showUploadModal();}"
                               class="inline-icon add-icon"
                               title="{{ "Add File" | translate }}"></a>
                        </h2>
                        <br />
                        <ul class="collection-list">
                            {% set inline_node_expanded = true %}
                            {% for fileDetails in UserDetails.files %}
                                {% include '/Partials/InlineFileField.html.twig' with {'_data': fileDetails, '_fileParentId': UserDetails.id} %}
                            {% else %}
                                <li><em>File list empty</em></li>
                            {% endfor %}
                            {% set inline_node_expanded = false %}
                        </ul>
                    </div>

                    {#
                    <div class="marked-section">
                        <h2>{{ "User Management" | translate }}</h2><br />
                        <a class="navigational-link" href="/graph/{{ primary_string_path | raw }}/@references?{{ url_metadata }}">{{ "See References" | translate }}</a>
                        <br>
                        <a class="navigational-link" href="/graph/{{ primary_string_path | raw }}/@pdf?{{ url_metadata }}">{{ "Generate PDF" | translate }}</a>
                    </div>
                    #}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

