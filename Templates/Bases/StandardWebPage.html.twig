<!DOCTYPE html>
<html lang="{{ _SELECTED_LANGUAGE_ }}">
    <head>
        <meta charset="utf-8">
        <meta id="viewport" name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1,maximum-scale=5,user-scalable=yes">
        <meta name="description" content="{{ page.description }}">
        {% block head_assets %}
            <style>@import url("/Static/CSS/StandardWebPage.css");</style>
            <link rel="stylesheet" href="/Static/CSS/ThirdParty/Calendar.css">
            <style>@import url("/Static/CSS/Elements/Calendar.css");</style>
            {% if "dark-mode" in head_asset_options %}
                <link rel="{# shortcut #}icon" type="image/png" href="/Static/Images/Logos/{{ _LOGO_PATH_ }}" />
                <style>@import url("/Static/CSS/Themes/DarkMode.css");</style>
            {% else %}
                <link rel="{# shortcut #}icon" type="image/png" href="/Static/Images/Logos/{{ _LOGO_CONTRAST_PATH_ }}" />
            {% endif %}
            {% if "large-fonts" in head_asset_options %}
                <style>@import url("/Static/CSS/Accessibility/LargeFonts.css");</style>
            {% endif %}
        {% endblock %}
        <title>{% block title %}{{ "Case Portal"|translate }}{% endblock %} - {{ _INSTANCE_NAME_ }}</title>

        {% include '/Partials/JSImports.html.twig' %}
    </head>

    <body>
        <nav>
            <div class="inner-content">
                <a id="skip-to-content-link" href="#main-content">{{ "Skip to Content"|translate|capitalize }}</a>
                <a id="navigation-logo" href="/">
                    <img alt="{{ _INSTANCE_NAME_ }} Logo" src="/Static/Images/Logos/{{ _LOGO_CONTRAST_PATH_ }}" />
                    {{ _INSTANCE_NAME_ }}
                </a>
                <a id="navigation-logo-ultra-small" href="/">
                    <img alt="{{ _INSTANCE_NAME_ }} Logo" src="/Static/Images/Logos/{{ _LOGO_CONTRAST_PATH_ }}" />
                </a>
                <div id="navigation-buttons">
                    {% if GetUserConfiguration("Instance", "Navigation", "About") %}
                        <a href="{{ GetUserConfiguration("Instance", "Navigation", "About") }}">{{ "About"|translate }}</a>
                    {% endif %}
                    {% if _IS_LOGGED_IN_ %}
                        <a href="/new-case">{{ "New Case"|translate }}</a>
                        <a href="/dashboard">{{ "Case Portal"|translate }}</a>
                    {% else %}
                        <a href="/onboard-new-case">{{ "New Clients"|translate }}</a>
                        <a href="/dashboard">{{ "Login"|translate }}</a>
                    {% endif %}
                    {% if _SELECTED_LANGUAGE_ == "en-GB" %}
                        <a href="/lang?switch=cy-GB" class="language-swap" lang="cy-GB" title="Newid iaith i'r Gymraeg"><strong>Cymraeg</strong></a>
                    {% else %}
                        <a href="/lang?switch=en-GB" class="language-swap" lang="en-GB" title="Switch language to English"><strong>English</strong></a>
                    {% endif %}
                </div>
                <div id="hamburger-menu-button">
                    <input type="checkbox" id="hamburger-menu-button-input" />
                    <label for="hamburger-menu-button-input"></label>
                    <span id="burger-bun-top"></span>
                    <span id="burger-meat"></span>
                    <span id="burger-bun-bottom"></span>
                    <div id="navigation-menu">
                        <div class="inner-content">
                            {% if GetUserConfiguration("Instance", "Navigation", "About") %}
                                <a href="{{ GetUserConfiguration("Instance", "Navigation", "About") }}">{{ "About"|translate }}</a>
                            {% endif %}
                            {% if _IS_LOGGED_IN_ %}
                                <a href="/onboard-new-case">{{ "New Case"|translate }}</a>
                                <a href="/dashboard">{{ "Case Portal"|translate }}</a>
                            {% else %}
                                <a href="/onboard-new-case">{{ "New Clients"|translate|title }}</a>
                                <a href="/dashboard">{{ "Login"|translate|title }}</a>
                            {% endif %}
                            {% if _SELECTED_LANGUAGE_ == "en-GB" %}
                                <a href="/lang?switch=cy-GB" class="language-swap" lang="cy-GB" title="Newid iaith i'r Gymraeg"><strong>Cymraeg</strong></a>
                            {% else %}
                                <a href="/lang?switch=en-GB" class="language-swap" lang="en-GB" title="Switch language to English"><strong>English</strong></a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        {% if _IS_LOGGED_IN_ %}
            <div id="portal-authenticated-user-bar">
                <div class="inner-content">
                    <p>
                        {{ "Logged in as: {username}"|translate({
                            '{username}': _CURRENTLY_LOGGED_IN_USER_FULL_NAME_
                        }) }}
                    </p>
                    <a href="/logout" class="button">{{ "Logout"|translate|title }}</a>
                </div>
            </div>
        {% endif %}

        {% block default_content_link %}<div id="main-content" class="reference-element"></div>{% endblock %}



        {% for bulletin in _SYSTEM_BULLETIN_ %}
            <div class="system-bulletin">
                <div class="inner-content">
                    {% if bulletin.severity == 'Critical' %}
                        <div class="critical-note">
                            {% if bulletin.title %}
                                <span class="note-heading">{{ bulletin.title }}</span>
                            {% endif %}
                            <p>{{ bulletin.content }}</p>
                            {% if bulletin.link %}
                                <p><a href="{{ bulletin.link }}">{{ bulletin.linkText | default("More information") | translate }}</a></p>
                            {% endif %}
                        </div>

                    {% elseif bulletin.severity == 'Warning' %}
                        <div class="note-warning side-note">
                            <h2>{{ bulletin.title }}</h2>
                            <p>{{ bulletin.content }}</p>
                            {% if bulletin.link %}
                                <p><a href="{{ bulletin.link }}">{{ bulletin.linkText | default("More information") | translate }}</a></p>
                            {% endif %}
                        </div>

                    {% elseif bulletin.severity == 'Informational' %}
                        <div class="note-info side-note">
                            <h2>{{ bulletin.title }}</h2>
                            <p>{{ bulletin.content }}</p>
                            {% if bulletin.link %}
                                <p><a href="{{ bulletin.link }}">{{ bulletin.linkText | default("More information") | translate }}</a></p>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}



        {% block content %}{% endblock %}

        <div class="spacer"></div>

        <footer>
            <div class="inner-content">
                <p>
                    <strong>
                        {{ "Copyright"|translate|ndsentence }} 2015 - {{ 'now' | date('Y') }} {{ _INSTANCE_NAME_ }}
                    </strong>
                </p>
                {% if GetUserConfiguration("Instance", "Contacts", "Operator") %}
                    <p>
                        {{
                            "{instanceName} is owned by operated by {operatorName}."|translate({
                                "{instanceName}": GetUserConfiguration("Instance", "Branding", "Name"),
                                "{operatorName}": "<a href=\"mailto: "
                                    ~ GetUserConfiguration("Instance", "Contacts", "Operator", "EmailAddress")
                                    ~ "\">"
                                    ~ GetUserConfiguration("Instance", "Contacts", "Operator", "Name")
                                    ~ "</a>"
                            })
                        }}
                    </p>
                {% endif %}
            </div>
        </footer>
        <footer>
            <div class="inner-content">
                <div class="logo-gallery-flow-box">
                    <!-- a href="https://www.tnlcommunityfund.org.uk/"><img id="funders-national-lottery" alt="National Lottery Community Fund logo" src="/assets/partners/national-lottery-fund-logo.png" /></a>
                    <a href="https://www.aber.ac.uk/"><img id="funders-aberystwyth-university" alt="Aberystwyth University logo" src="/assets/partners/aberystwyth-university-logo.png" /></a -->
                </div>
                <ul class="link-list">
                    <!-- <li><a href="/complaints-procedure">Complaints procedure</a></li>
                    <li><a href="/privacy-policy">Privacy policy &amp; GDPR</a></li>
                    <li><a href="/accessibility-statement">Accessibility statement</a></li>
                    <li><a href="/contact">Contact us</a></li>
                    -->
                    {% if PRIVACY_POLICY_URL %}
                        <a href="{{ PRIVACY_POLICY_URL }}">{{ "Privacy Policy"|translate|ndsentence }}</a>
                    {% endif %}
                    {% if ACCESSIBILITY_STATEMENT_URL %}
                        <a href="{{ ACCESSIBILITY_STATEMENT_URL }}">{{ "Accessibility Statement"|translate|ndsentence }}</a>
                    {% endif %}
                    {% if CONTACT_US_URL %}
                        <a href="{{ CONTACT_US_URL }}">{{ "Contact Us"|translate|ndsentence }}</a>
                    {% endif %}
                    {% if ABOUT_PAGE_URL %}
                        <a href="{{ ABOUT_PAGE_URL }}">{{ "About Us"|translate|ndsentence }}</a>
                    {% endif %}

                    <li><a href="/onboard-new-case">{{ "Open New Case"|translate|ndsentence }}</a></li>
                    <li><a href="/dashboard">{{ "Home"|translate|ndsentence }}</a></li>
                    {% if _SELECTED_LANGUAGE_ == "en-GB" %}
                        <li><a href="/lang?switch=cy-GB" lang="cy-GB">Newid iaith i'r Gymraeg (Switch language to Welsh)</a></li>
                    {% else %}
                        <li><a href="/lang?switch=en-GB" lang="en-GB">Switch language to English (Newid iaith i'r Saesneg)</a></li>
                    {% endif %}
                    <li><a href="/style?switch=dark-mode">{{ "Toggle Dark Mode"|translate|ndsentence }}</a></li>
                    <li><a href="/style?switch=large-fonts">{{ "Toggle Large Fonts"|translate|ndsentence }}</a></li>
                </ul>
                <div class="spacer"></div>
                <span>{{ GetSystemConfiguration("Development", "CurrentVersion") }}</span>
                <div class="spacer"></div>
            </div>
        </footer>
    </body>
</html>
