
{% if _data|is_uuid %}
    {% set _fieldID = GeneratePseudoRandomCharacters(16) %}

    {% if _INLINE_NODE_EXPANDED_ %}
        <h3 class="low-margin-heading">
            <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %} class="navigational-link" href="/users/{{ _data }}">
                <span class="inline-icon-shift-left inline-icon-low-margin account-box-icon" title="User account">
                </span>
                <span id="{{ _fieldID }}-A"></span>
            </a>
        </h3>
        <div class="small-spacer"></div>
        <dl>
        </dl>
    {% else %}
        <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %}class="navigational-link" href="/users/{{ _data }}">
            <span class="inline-icon-shift-left inline-icon-low-margin account-box-icon" title="User account">
            </span>
            <span id="{{ _fieldID }}-B"></span>
        </a>
    {% endif %}

    <script>

        document.addEventListener('DOMContentLoaded', async function() {
            document.getElementById('{{_fieldID}}-{% if _INLINE_NODE_NEW_TAB_ %}A{% else %}B{% endif %}').textContent = (await (new UserController()).GetSingleUser('{{ _data }}'))['full_name'];
        });
    </script>





{% elseif _data.detail == 'User not found' %}
    <h3 class="low-margin-heading">
        <span class="inline-icon-shift-left inline-icon-low-margin account-box-icon" title="User account">
        </span>
        <em>{{ "Deleted User"|translate }}</em>
    </h3>





{% else %}
    {% if _INLINE_NODE_EXPANDED_ %}
        <h3 class="low-margin-heading">
            <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %} class="navigational-link" href="/users/{{ _data.id }}">
                <span class="inline-icon-shift-left inline-icon-low-margin account-box-icon" title="User account">
                </span>
                {% if _data.full_name %}
                    {{ _data.full_name }}
                {% else %}
                    {{ "{" ~ _data.id ~ "}" }}
                {% endif %}
            </a>
        </h3>
        <div class="small-spacer"></div>
        <dl>
        </dl>
    {% else %}
        <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %}class="navigational-link" href="/users/{{ _data.id }}">
            <span class="inline-icon-shift-left inline-icon-low-margin account-box-icon" title="User account">
            </span>
            {% if _data.full_name %}
                {{ _data.full_name }}
            {% else %}
                {{ "{" ~ _data.id ~ "}" }}
            {% endif %}
        </a>
    {% endif %}
{% endif %}

