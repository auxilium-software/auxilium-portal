{% if _data|is_auxlfs_url %}
    {% set _fieldID = GeneratePseudoRandomCharacters(16) %}
    {% set _fileId = _data|extract_file_id_from_auxlfs_url %}

    {% if _fileParentType == 'CASE' %}
        {% set _viewUrl = '/cases/' ~ _fileParentId ~ '/files/' ~ _fileId %}
    {% else %}
        {% set _viewUrl = '/users/' ~ _fileParentId ~ '/files/' ~ _fileId %}
    {% endif %}

    {% if _INLINE_NODE_EXPANDED_ %}
        <h3 class="low-margin-heading">
            <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %} href="{{ _viewUrl }}">
                <span class="inline-icon-shift-left inline-icon-low-margin file-present-icon" title="File"></span>
                <span id="{{ _fieldID }}-A"></span>
            </a>
            <span id="{{ _fieldID }}-A-RemoveButton"></span>
        </h3>
        <div class="small-spacer"></div>
        <dl></dl>
    {% else %}
        <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %} href="{{ _viewUrl }}">
            <span class="inline-icon-shift-left inline-icon-low-margin file-present-icon" title="File"></span>
            <span id="{{ _fieldID }}-B"></span>
        </a>
        <span id="{{ _fieldID }}-B-RemoveButton"></span>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            const fileController = new FileController();

            document.getElementById('{{ _fieldID }}-{% if _INLINE_NODE_EXPANDED_ %}A{% else %}B{% endif %}').textContent
                = (await fileController.GetSingleFileFromAuxLFSURL('{{ _fileParentType }}', '{{ _fileParentId }}', '{{ _data }}'))['filename'];

            document.getElementById('{{ _fieldID }}-{% if _INLINE_NODE_EXPANDED_ %}A{% else %}B{% endif %}-RemoveButton').innerHTML = `
                <a href="#"
                    class="inline-icon link-off-icon"
                    title="{{ "Delete File" | translate }}"
                    onclick="{const fm = new FileManager('{{ _fileParentType }}', '{{ _fileParentId }}'); fm.removeFile('{{ _data }}', true).then(() => {window.location.reload();});}"
                ></a>
            `;
        });
    </script>
{% endif %}