
{% if _data|is_auxlfs_url %}
    {% set _fieldID = GeneratePseudoRandomCharacters(16) %}

    {% if _INLINE_NODE_EXPANDED_ %}
        <h3 class="low-margin-heading">
            <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %} class="navigational-link" href="/files/{{ _data|extract_file_id_from_auxlfs_url }}">
                <span class="inline-icon-shift-left inline-icon-low-margin file-present-icon" title="User account">
                </span>
                <span id="{{ _fieldID }}-A"></span>
            </a>
        </h3>
        <div class="small-spacer"></div>
        <dl>
        </dl>
    {% else %}
        <a {% if _INLINE_NODE_NEW_TAB_ %} class="navigational-link-new-tab" target="_blank" {% else %} class="navigational-link" {% endif %}class="navigational-link" href="/files/{{ _data|extract_file_id_from_auxlfs_url }}">
            <span class="inline-icon-shift-left inline-icon-low-margin file-present-icon" title="User account">
            </span>
            <span id="{{ _fieldID }}-B"></span>
        </a>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            document.getElementById('{{_fieldID}}-{% if _INLINE_NODE_NEW_TAB_ %}A{% else %}B{% endif %}').textContent
                    = (await (new FileController()).GetSingleFileFromAuxLFSURL('{{ _data }}'))['filename'];
        });
    </script>





{% else %}
{% endif %}

