{% extends "/Bases/StandardWebPage.html.twig" %}

{% block title %}{{ "Set Password"|translate }}{% endblock %}

{% block content %}
    <div>
        <div class="inner-content">
            <h1>{{ "Set Password"|translate }}</h1>

            <div id="TokenErrorMessage" class="error-toast" style="display:none;">
                <span>{{ "Invalid or missing token. Please check your email link and try again."|translate }}</span>
            </div>

            <form method="POST" id="SetPasswordForm">
                <label for="new_password">{{ "New Password"|translate }} {% include '/Partials/RequiredAsterisk.html.twig' %}</label>
                <input type="password" name="new_password" placeholder="{{ "New Password"|translate }}" id="new_password" />
                <p id="ErrorReadout-NewPassword" class="error-toast" style="display:none;"></p>

                <label for="confirm_password">{{ "Confirm Password"|translate }} {% include '/Partials/RequiredAsterisk.html.twig' %}</label>
                <input type="password" name="confirm_password" placeholder="{{ "Confirm Password"|translate }}" id="confirm_password" />
                <p id="ErrorReadout-ConfirmPassword" class="error-toast" style="display:none;"></p>

                <button type="submit" id="SetPasswordButton" class="button">
                    <span class="button-text">{{ "Set Password"|translate }}</span>
                    <span class="loading-spinner" style="display:none;">⏳</span>
                </button>

                <div class="separator"></div>
                <a href="/login">{{ "Back to login"|translate }}</a>
            </form>
        </div>
    </div>

    <script src="/Static/JS/Handlers/SetInitialPasswordFormHandler.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            new SetInitialPasswordFormHandler();
        });
    </script>
{% endblock %}
