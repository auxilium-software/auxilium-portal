{% extends "/Bases/StandardWebPage.html.twig" %}

{% block title %}{{ "search" | translate }}{% endblock %}

{% block content %}

    <div>
        <div class="inner-content">
            <div class="navigation-breadcrumb-container">
                <a class="navigation-breadcrumb" href="/dashboard">{{ "Home" | translate }}</a>
                <a class="navigation-breadcrumb" href="/search">{{ "Object Search" | translate }}</a>
            </div>

            <h1>{{ "Object Search" | translate }}</h1>

            <input type="text" id="SearchInput" placeholder="Search..." onkeyup="handleSearch()" disabled>

            <ul id="SearchResults"></ul>

            <script>
                const inputField = document.getElementById("SearchInput");

                const userController = new UserController();
                const caseController = new CaseController();

                document.addEventListener('DOMContentLoaded', async function() {
                    const allUsers = await userController.GetAllUsers_DontDoThisLol();
                    const allCases = await caseController.GetAllCases_DontDoThisLol();
                    new ToastNotification("Data loaded", "check-circle", "success").doAfter(() => {
                        inputField.removeAttribute("disabled");
                    });
                });

                function handleSearch()
                {

                }
            </script>
        </div>
    </div>
{% endblock %}
