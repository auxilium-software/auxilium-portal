{% extends "/Bases/StandardWebPage.html.twig" %}

{% block title %}{{ "MFA Management"|translate }}{% endblock %}

{% block content %}

    <div>
        <div class="inner-content">
            <div class="navigation-breadcrumb-container">
                <a class="navigation-breadcrumb" href="/dashboard">{{ "Home"|translate }}</a>
                <a class="navigation-breadcrumb" href="/me">{{ "User Overview"|translate }}</a>
                <a class="navigation-breadcrumb" href="/me/wemwbs">{{ "WEMWBS"|translate }}</a>
            </div>

            <h1>{{ "The Warwick-Edinburgh Mental Wellbeing Scale (WEMWBS)"|translate }}</h1>

            <div class="separator"></div>

            <a class="button" href="/me/wemwbs/new-assessment">{{ "New Assessment"|translate }}</a>


            <div class="marked-section">
                <h2> {{ "WEMWBS Overview" | translate }}</h2>
                <dl id="properties-list" class="">
                    <dt>{{ "Total Assessments"|translate }}</dt>
                    <dd>{{ Assessments.totalAssessments }}</dd>

                    <dt>{{ "Average Score"|translate }}</dt>
                    <dd>{{ Assessments.averageScore }}</dd>

                    <dt>{{ "Lowest Score"|translate }}</dt>
                    <dd>{{ Assessments.lowestScore }}</dd>

                    <dt>{{ "Highest Score"|translate }}</dt>
                    <dd>{{ Assessments.highestScore }}</dd>

                    <dt>{{ "Trend"|translate }}</dt>
                    <dd>{{ Assessments.trend }}</dd>
                </dl>
            </div>
        </div>
    </div>

    <style>
    </style>

    <script>
    </script>

{% endblock %}
