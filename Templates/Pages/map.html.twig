{% extends "/Bases/StandardWebPage.html.twig" %}

{% block title %}{{ "Map"|translate }}{% endblock %}

{% block content %}

    <div>
        <div class="inner-content">
            <div class="navigation-breadcrumb-container">
                <a class="navigation-breadcrumb" href="/dashboard">{{ "Home"|translate }}</a>
                <a class="navigation-breadcrumb" href="/map">{{ "Map"|translate }}</a>
            </div>

            <h1>{{ "Map"|translate }}</h1>

            <script src="https://cdn.jsdelivr.net/npm/vis-network@9.1.2/dist/vis-network.min.js"></script>
            <link href="https://cdn.jsdelivr.net/npm/vis-network@9.1.2/dist/dist/vis-network.min.css" rel="stylesheet" />
            <style>
                #graph {
                    width: 100%;
                    height: 100vh;
                    border: 1px solid lightgray;
                }

                #loading-overlay {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(255, 255, 255, 0.95);
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    z-index: 10;
                }

                #progress-container {
                    width: 300px;
                    max-width: 80%;
                }

                #progress-bar-bg {
                    width: 100%;
                    height: 12px;
                    background: #e0e0e0;
                    border-radius: 6px;
                    overflow: hidden;
                }

                #progress-bar {
                    width: 0%;
                    height: 100%;
                    background: linear-gradient(90deg, #FFD700, #FFA500);
                    border-radius: 6px;
                    transition: width 0.3s ease;
                }

                #progress-text {
                    margin-top: 12px;
                    font-size: 14px;
                    color: #666;
                    text-align: center;
                }
            </style>

            <div style="position: relative;">
                <div id="loading-overlay">
                    <div id="progress-container">
                        <div id="progress-bar-bg">
                            <div id="progress-bar"></div>
                        </div>
                        <p id="progress-text">{{ "Initializing..."|translate }}</p>
                    </div>
                </div>
                <div id="graph"></div>
            </div>

            <script>
                const caseController = new CaseController();
                const userController = new UserController();

                function updateProgress(percent, message)
                {
                    document.getElementById('progress-bar').style.width = percent + '%';
                    document.getElementById('progress-text').textContent = message;
                }

                document.addEventListener('DOMContentLoaded', async function() {
                    const loadingOverlay = document.getElementById('loading-overlay');

                    updateProgress(10, "{{ 'Loading cases...'|translate }}");
                    const allCases = await caseController.GetAllCases_DontDoThisLol();

                    updateProgress(30, "{{ 'Loading users...'|translate }}");
                    const allUsers = await userController.GetAllUsers_DontDoThisLol();

                    updateProgress(50, "{{ 'Building graph...'|translate }}");

                    let nodeBuilder = [];
                    let edgeBuilder = [];

                    for (const temp of allCases)
                    {
                        nodeBuilder.push({
                            id: "CASE@" + temp.id,
                            label: temp.title,
                            group: 'case'
                        });
                        for (const temp2 of temp.workers)
                        {
                            edgeBuilder.push({
                                from: "PERSON@" + temp2,
                                to: "CASE@" + temp.id,
                                color: "rgb(113,0,154)",
                                label: "Worker",
                                font: { face: "Monospace", align: "middle" },
                            });
                        }
                        for (const temp2 of temp.clients)
                        {
                            edgeBuilder.push({
                                from: "PERSON@" + temp2,
                                to: "CASE@" + temp.id,
                                color: "rgb(0,154,67)",
                                label: "Client",
                                font: { face: "Monospace", align: "middle" },
                            });
                        }
                    }
                    for (const temp of allUsers)
                    {
                        nodeBuilder.push({
                            id: "PERSON@" + temp.id,
                            label: temp.fullName,
                            group: 'person'
                        });
                    }

                    updateProgress(70, "{{ 'Rendering network...'|translate }}");

                    const nodes = new vis.DataSet(nodeBuilder);
                    const edges = new vis.DataSet(edgeBuilder);

                    const container = document.getElementById('graph');
                    const data = { nodes, edges };
                    const options = {
                        nodes: {
                            shape: 'dot',
                            size: 16,
                            font: { size: 14 }
                        },
                        edges: {
                            font: { align: 'middle' }
                        },
                        physics: {
                            enabled: true,
                            solver: 'forceAtlas2Based'
                        },
                        groups: {
                            case: { color: { background: '#FFD700' }, shape: 'box' },
                            person: { color: { background: '#87CEEB' } }
                        }
                    };

                    const network = new vis.Network(container, data, options);

                    updateProgress(85, "{{ 'Stabilising layout...'|translate }}");

                    network.once("stabilized", function() {
                        updateProgress(100, "{{ 'Complete!'|translate }}");
                        setTimeout(() => {
                            loadingOverlay.style.display = 'none';
                        }, 300);
                    });

                    network.on("click", function (params) {
                        if (params.nodes.length)
                        {
                            if (params.nodes[0].startsWith("CASE@"))
                            {
                                window.location = "/cases/" + params.nodes[0].replace("CASE@", "");
                            }
                            else if (params.nodes[0].startsWith("PERSON@"))
                            {
                                window.location = "/users/" + params.nodes[0].replace("PERSON@", "");
                            }
                        }
                    });
                });
            </script>
        </div>
    </div>
{% endblock %}
