        // ====================================================================================================
        // LOGIN ATTEMPTS
        // ====================================================================================================
        async function refreshLoginAttempts(page = 1)
        {
            try
            {
                const filterType = document.getElementById('logFilterType').value;
                const ipFilter = document.getElementById('logFilterIp').value.trim();
                const emailFilter = document.getElementById('logFilterEmail').value.trim();
                const count = document.getElementById('logFilterCount').value;

                let url = `/api/v3/web-application-firewall/login-attempts?page=${page}&pageSize=${count}`;
                if (filterType === 'failed') url += '&failedOnly=true';
                else if (filterType === 'success') url += '&successfulOnly=true';
                else if (filterType === 'blocked') url += '&blockedOnly=true';
                if (ipFilter) url += '&ipAddress=' + encodeURIComponent(ipFilter);
                if (emailFilter) url += '&email=' + encodeURIComponent(emailFilter);

                const [status, data] = await api.API_GET(url);
                if (status !== 200) throw new Error('{{ "Failed to fetch"|translate }}');
                wafState.loginAttempts = data.attempts || [];

                renderLoginAttempts();

                document.getElementById('logPaginationInfo').textContent = await Localisation.translate(
                    "Showing {loginAttemptCount} of {totalLoginAttempts}",
                    {
                        "{loginAttemptCount}": data.attempts.length,
                        "{totalLoginAttempts}": data.totalCount,
                    }
                );
                document.getElementById('lastRefreshTime').textContent = Localisation.translate(
                    "Last refresh: {currentDateTime}",
                    {
                        "{currentDateTime}": new Date().toLocaleTimeString(),
                    }
                );

                let btns = '';
                if (data.page > 1) btns += `<button class="form-btn form-btn--sm" onclick="refreshLoginAttempts(${data.page - 1})"><i class="ph-duotone ph-skip-back"></i> {{ "Prev"|translate }}</button>`;
                if (data.page < data.totalPages) btns += `<button class="form-btn form-btn--sm" onclick="refreshLoginAttempts(${data.page + 1})">{{ "Next"|translate }} <i class="ph-duotone ph-skip-forward"></i></button>`;
                document.getElementById('logPaginationBtns').innerHTML = btns;
            }
            catch (err)
            {
                console.error('{{ "Failed to load login attempts:"|translate }}', err);
                document.getElementById('loginAttemptsBody').innerHTML = '<tr><td colspan="6" class="empty-state" style="color:#cc0000;">{{ "Error"|translate }}</td></tr>';
            }
        }

        function renderLoginAttempts()
        {
            const tbody = document.getElementById('loginAttemptsBody');
            if (!wafState.loginAttempts.length)
            {
                tbody.innerHTML = '<tr><td colspan="6" class="empty-state">{{ "No login attempts"|translate }}</td></tr>';
                return;
            }
            let html = '';
            wafState.loginAttempts.forEach(a => {
                let statusClass, statusText;
                if (a.wasBlockedByWaf)
                {
                    statusClass = 'status-blocked';
                    statusText = 'BLOCKED';
                }
                else if (a.wasSuccessful)
                {
                    statusClass = 'status-success';
                    statusText = 'OK';
                }
                else
                {
                    statusClass = 'status-error';
                    statusText = 'FAIL';
                }
                html += `<tr>
                    <td>${formatDate(a.attemptedAt)}</td>
                    <td class="cell-status ${statusClass}">${statusText}</td>
                    <td class="waf-ip-cell"><a href="javascript:void(0)" onclick="showIpDetails('${escapeHtml(a.ipAddress)}')">${escapeHtml(a.ipAddress)}</a></td>
                    <td>${escapeHtml(a.targetEmail || '-')}</td>
                    <td class="waf-truncate" title="${escapeHtml(a.failureReason || '')}">${escapeHtml(a.failureReason || '-')}</td>
                    <td class="cell-actions">${!a.wasSuccessful ? `<button onclick="quickBlock('${escapeHtml(a.ipAddress)}')">{{ "Block"|translate }}</button>` : ''}</td>
                </tr>`;
            });
            tbody.innerHTML = html;
        }





        // ====================================================================================================
        // IP DETAILS
        // ====================================================================================================
        async function showIpDetails(ipAddress) {
            document.getElementById('ipDetailsTitle').textContent = ipAddress;
            document.getElementById('ipDetailsContent').innerHTML = '<div class="empty-state">Loading...</div>';
            document.getElementById('ipDetailsOverlay').classList.add('is-visible');
            document.getElementById('ipDetailsBlockBtn').onclick = () => blockFromDetails(ipAddress);
            try {
                const [status, data] = await api.API_GET(`/api/v3/web-application-firewall/blacklist/ips/${encodeURIComponent(ipAddress)}`);
                if (status === 404)
                {
                    document.getElementById('ipDetailsContent').innerHTML = `<div class="status-row"><span>{{ "Status"|translate }}</span><span>{{ "Not Blocked"|translate }}</span></div><p style="margin-top:15px;color:#666;">{{ "No block history found."|translate }}</p>`;
                    document.getElementById('ipDetailsBlockBtn').style.display = 'inline-block';
                    return;
                }
                if (status !== 200) throw new Error('{{ "Failed"|translate }}');
                let html = `<div class="status-row"><span>{{ "Current Status"|translate }}</span><span class="${data.currentBlock ? 'status-error' : ''}">${data.currentBlock ? '{{ "BLOCKED"|translate }}' : '{{ "Not Blocked"|translate }}'}</span></div>
                    <div class="status-row"><span>{{ "First Seen At"|translate }}</span><span>${data.firstSeenAt ? formatDate(data.firstSeenAt) : '-'}</span></div>
                    <div class="status-row"><span>{{ "Last Seen At"|translate }}</span><span>${data.lastSeenAt ? formatDate(data.lastSeenAt) : '-'}</span></div>
                    <div class="status-row"><span>{{ "Failed Attempts"|translate }}</span><span>${data.totalFailedAttempts}</span></div>
                    <div class="status-row"><span>{{ "Blocked Attempts"|translate }}</span><span>${data.totalBlockedAttempts}</span></div>`;
                if (data.currentBlock)
                {
                    html += `<h4 style="margin-top:15px;">{{ "Current Block"|translate }}</h4>
                        <div class="status-row"><span>{{ "Type"|translate }}</span><span>${data.currentBlock.isPermanent ? '{{ "Permanent"|translate }}' : '{{ "Temporary"|translate }}'}</span></div>
                        <div class="status-row"><span>{{ "Reason"|translate }}</span><span>${escapeHtml(data.currentBlock.reason || '-')}</span></div>
                        <div class="status-row"><span>{{ "Blocked At"|translate }}</span><span>${formatDate(data.currentBlock.blockedAt)}</span></div>`;
                    document.getElementById('ipDetailsBlockBtn').style.display = 'none';
                }
                else
                {
                    document.getElementById('ipDetailsBlockBtn').style.display = 'inline-block';
                }
                if (data.blockHistory?.length)
                {
                    const blockHistoryText = await Localisation.translate(
                        "Block History (blockHistoryCount)",
                        {
                            "{blockHistoryCount}": data.blockHistory.length
                        }
                    );
                    html += `<h4 style="margin-top:15px;">${blockHistoryText}</h4><div style="max-height:150px;overflow-y:auto;">`;
                    data.blockHistory.forEach(h => {
                        html += `<div style="padding:6px 0;border-bottom:1px solid #eee;font-size:11px;">
                            <div><strong>${h.isPermanent ? '{{ "Permanent"|translate }}' : '{{ "Temporary"|translate }}'}</strong> - ${escapeHtml(h.reason || '{{ "No reason"|translate }}')}</div>
                            <div style="color:#666;">${formatDate(h.blockedAt)} ${h.wasManuallyUnblocked ? '<i class="ph-duotone ph-arrow-right"></i> {{ "Unblocked"|translate }}' : ''}</div>
                        </div>`;
                    });
                    html += '</div>';
                }
                if (data.recentLoginAttempts?.length)
                {
                    html += `<h4 style="margin-top:15px;">{{ "Recent Attempts"|translate }}</h4><div style="max-height:150px;overflow-y:auto;">`;
                    data.recentLoginAttempts.slice(0, 20).forEach(a => {
                        const icon = a.wasBlockedByWaf ? '🚫' : (a.wasSuccessful ? '✓' : '✗');
                        html += `<div style="padding:4px 0;border-bottom:1px solid #eee;font-size:11px;">${icon} ${formatDate(a.attemptedAt)} - ${escapeHtml(a.targetEmail || '{{ "Unknown"|translate }}')}</div>`;
                    });
                    html += '</div>';
                }
                document.getElementById('ipDetailsContent').innerHTML = html;
            }
            catch (err)
            {
                document.getElementById('ipDetailsContent').innerHTML = '<div class="empty-state" style="color:#cc0000;">{{ "Error loading details"|translate }}</div>';
            }
        }

        function closeIpDetails()
        {
            document.getElementById('ipDetailsOverlay').classList.remove('is-visible');
