        async function updateAlerts()
        {
            const s = wafState.statistics;
            const container = document.getElementById('alertsContainer');
            const badge = document.getElementById('alertCountBadge');
            const alerts = [];
            if (s)
            {
                if (!s.wafEnabled)
                {
                    alerts.push({ type: 'danger', message: '{{ "WAF is currently DISABLED"|translate }}' });
                }

                if (s.failedLoginAttempts > 100)
                {
                    const message = await Localisation.translate(
                        "High failed logins: {failedLoginAttemptCount}",
                        {
                            "{failedLoginAttemptCount}": s.failedLoginAttempts
                        }
                    );
                    alerts.push({ type: 'danger', message: message });
                }
                else if (s.failedLoginAttempts > 20)
                {
                    const message = await Localisation.translate(
                        "Elevated failed logins: {failedLoginAttemptCount}",
                        {
                            "{failedLoginAttemptCount}": s.failedLoginAttempts
                        }
                    );
                    alerts.push({ type: 'warning', message: message });
                }

                if (s.permanentlyBannedIps > 0)
                {
                    const message = await Localisation.translate(
                        "{permanentlyBannedIpsCount} permanent ban(s) active",
                        {
                            "{permanentlyBannedIpsCount}": s.permanentlyBannedIps
                        }
                    );
                    alerts.push({ type: 'info', message: message });
                }

                if (s.lockedOutUsers > 0)
                {
                    const message = await Localisation.translate(
                        "{lockedOutUsersCount} user(s) locked",
                        {
                            "{lockedOutUsersCount}": s.lockedOutUsers
                        }
                    );
                    alerts.push({ type: 'warning', message: message });
                }

                for (const t of s.topTargetedUsers)
                {
                    if (t.distinctIpAddresses >= 5)
                    {
                        const message = await Localisation.translate(
                            "Distributed attack on {emailAddress}: {distinctIpAddressesCount} IPs",
                            {
                                "{emailAddress}": t.email,
                                "{distinctIpAddressesCount}": t.distinctIpAddresses
                            }
                        )
                        alerts.push({ type: 'danger', message: message });
                    }
                }
            }
            badge.textContent = alerts.length;
            badge.className = 'badge ' + (alerts.length > 0 ? 'badge--inactive' : 'badge--active');
            if (!alerts.length)
            {
                container.innerHTML = '<div class="empty-state">{{ "No active alerts"|translate }}</div>';
                return;
            }
            let html = '';
            alerts.slice(0, 8).forEach(a => {
                const cls = a.type === 'warning' ? 'waf-alert-item--warning' : (a.type === 'info' ? 'waf-alert-item--info' : '');
                html += `<div class="waf-alert-item ${cls}"><div class="waf-alert-item__message">${escapeHtml(a.message)}</div></div>`;
            });
            container.innerHTML = html;
        }





