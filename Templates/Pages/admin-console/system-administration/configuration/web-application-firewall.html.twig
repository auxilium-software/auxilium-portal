        // ====================================================================================================
        // ACTIONS
        // ====================================================================================================
        async function blockIp()
        {
            const ip = document.getElementById('targetIpInput').value.trim();
            const reason = document.getElementById('blockReasonInput').value.trim();
            const isPermanent = document.getElementById('blockTypeSelect').value === 'permanent';
            const duration = parseInt(document.getElementById('blockDurationInput').value) || 60;
            if (!ip)
            {
                alert('{{ "Enter an IP address"|translate }}');
                return;
            }
            wafState.pendingAction = {
                action: async () => {
                    const [status, data] = await api.API_POST('/api/v3/web-application-firewall/block-ip', {
                        ipAddress: ip,
                        reason: reason || 'Manually blocked', //TODO: figure out whether this be translated
                        isPermanent,
                        durationMinutes: isPermanent ? null : duration
                    });
                    if (status === 201)
                    {
                        document.getElementById('targetIpInput').value = '';
                        document.getElementById('blockReasonInput').value = '';
                        loadAllData();
                        return true;
                    }
                    throw new Error(data.message || 'Failed');
                }
            };
            showConfirmDialog(
                '<i class="ph-duotone ph-prohibit"></i>',
                '{{ "Block IP"|translate }}',
                await Localisation.translate(
                    "Block {ipAddress} {duration}?",
                    {
                        "{ipAddress}": ip,
                        "{duration}": isPermanent ? '{{ "permanently"|translate }}' : await Localisation.translate(
                            "for {duration} minutes",
                            {
                                "{duration}": duration
                            }
                        )
                    }
                ),
            );
        }

        async function quickBlock(ip)
        {
            document.getElementById('targetIpInput').value = ip;
            document.getElementById('blockReasonInput').value = '{{ "Blocked from WAF monitor"|translate }}';
            await blockIp();
        }

        async function unblockIp()
        {
            const ip = document.getElementById('targetIpInput').value.trim();
            if (!ip) { alert('Enter an IP address'); return; }
            wafState.pendingAction = {
                showReason: true,
                action: async (reason) => {
                    const url = `/api/v3/web-application-firewall/blocked-ips/${encodeURIComponent(ip)}${reason ? '?reason=' + encodeURIComponent(reason) : ''}`;
                    const [status, data] = await api.API_DELETE(url);
                    if (status === 204)
                    {
                        document.getElementById('targetIpInput').value = '';
                        loadAllData();
                        return true;
                    }
                    throw new Error(data.message || 'Failed');
                }
            };
            showConfirmDialog(
                '<i class="ph-duotone ph-check"></i>',
                '{{ "Unblock IP"|translate }}',
                await Localisation.translate(
                    "Unblock {ipAddress}?",
                    {
                        "{ipAddress}": ip,
                    }
                ),
                true
            );
        }

        async function quickUnblock(ip)
        {
            wafState.pendingAction = {
                showReason: true,
                action: async (reason) => {
                    const [status, data] = await api.API_DELETE(`/api/v3/web-application-firewall/blocked-ips/${encodeURIComponent(ip)}${reason ? '?reason=' + encodeURIComponent(reason) : ''}`);
                    if (status === 204) { loadAllData(); return true; }
                    throw new Error(data.message || '{{ "Failed"|translate }}');
                }
            };
            showConfirmDialog(
                '<i class="ph-duotone ph-check"></i>',
                '{{ "Unblock IP"|translate }}',
                await Localisation.translate(
                    "Unblock {ipAddress}?",
                    {
                        "{ipAddress}": ip,
                    }
                ),
                true
            );
        }

        async function unlockUser(userId, email) {
            wafState.pendingAction = {
                showReason: true,
                action: async (reason) => {
                    const [status, data] = await api.API_POST(`/api/v3/web-application-firewall/locked-out-users/${userId}/unlock`, { reason: reason || null });
                    if (status === 204)
                    {
                        loadAllData();
                        return true;
                    }
                    throw new Error(data.message || '{{ "Failed"|translate }}');
                }
            };
            showConfirmDialog(
                '<i class="ph-duotone ph-lock-key-open"></i>',
                '{{ "Unlock User"|translate }}',
                await Localisation.translate(
                    "Unlock {emailOrUserId}?",
                    {
                        "{emailOrUserId}": email || userId,
                    }
                ),
                true
            );
        }

        async function addToWhitelist()
        {
            const ip = document.getElementById('targetIpInput').value.trim();
            if (!ip)
            {
                alert('{{ "Enter an IP address"|translate }}');
                return;
            }
            wafState.pendingAction = {
                showReason: true,
                action: async (reason) => {
                    const [status, data] = await api.API_POST(
                        '/api/v3/web-application-firewall/whitelist/ips',
                        {
                            ipAddress: ip,
                            reason: reason || null
                        }
                    );
                    if (status === 200)
                    {
                        document.getElementById('targetIpInput').value = '';
                        loadAllData();
                        return true;
                    }
                    throw new Error(data.message || '{{ "Failed"|translate }}');
                }
            };
            showConfirmDialog(
                '<i class="ph-duotone ph-star"></i>',
                '{{ "Add to Whitelist"|translate }}',
                await Localisation.translate(
                    "Whitelist {ipAddress}? This IP will bypass all WAF checks!",
                    {
                        "{ipAddress}": ip,
                    }
                ),
                true
            );
        }

        async function removeFromWhitelist(ip)
        {
            wafState.pendingAction = {
                showReason: true,
                action: async (reason) => {
                    const [status, data] = await api.API_DELETE(`/api/v3/web-application-firewall/whitelist/${encodeURIComponent(ip)}${reason ? '?reason=' + encodeURIComponent(reason) : ''}`);
                    if (status === 200) { loadAllData(); return true; }
                    throw new Error(data.message || 'Failed');
                }
            };
            showConfirmDialog(
                '☆',
                '{{ "Remove from Whitelist"|translate }}',
                await Localisation.translate(
                    "Remove {ipAddress} from whitelist?",
                    {
                        "{ipAddress}": ip,
                    }
                ),
                true
            );
        }





        // ====================================================================================================
        // CONFIRM DIALOGUE
        // ====================================================================================================
        function showConfirmDialog(icon, title, message, showReason = false)
        {
            document.getElementById('confirmIcon').innerHTML = icon;
            document.getElementById('confirmTitle').textContent = title;
            document.getElementById('confirmMessage').textContent = message;
            document.getElementById('confirmReasonField').style.display = showReason ? 'block' : 'none';
            document.getElementById('confirmReasonInput').value = '';
            document.getElementById('confirmOverlay').classList.add('is-visible');
        }

        function closeConfirmDialog()
        {
            document.getElementById('confirmOverlay').classList.remove('is-visible');
            wafState.pendingAction = null;
        }

        async function executeConfirmedAction()
        {
            if (!wafState.pendingAction) return;
            const btn = document.getElementById('confirmActionBtn');
            const originalText = btn.textContent;
            btn.textContent = '{{ "Processing..."|translate }}';
            btn.disabled = true;
            try
            {
                const reason = document.getElementById('confirmReasonInput').value.trim();
                await wafState.pendingAction.action(reason);
                closeConfirmDialog();
            }
            catch (err)
            {
                alert(err.message || '{{ "Action failed"|translate }}');
            }
            finally { btn.textContent = originalText; btn.disabled = false; }
        }





        // ====================================================================================================
        // AUTO REFRESH
        // ====================================================================================================
        function toggleAutoRefresh()
        {
            const enabled = document.getElementById('autoRefreshCheck').checked;
            if (wafState.autoRefreshInterval)
            {
                clearInterval(wafState.autoRefreshInterval);
                wafState.autoRefreshInterval = null;
            }
            if (enabled) wafState.autoRefreshInterval = setInterval(loadAllData, 30000);
        }





        // ====================================================================================================
        // EXPORT
        // ====================================================================================================
        function exportBlockedIps()
        {
            let csv = 'IP Address,Type,Reason,Blocked At,Expires At,Active\n';
            wafState.blockedIps.forEach(b => { csv += `"${b.ipAddress}","${b.isPermanent ? 'Permanent' : 'Temporary'}","${(b.reason || '').replace(/"/g, '""')}","${b.blockedAt}","${b.expiresAt || ''}","${b.isActive}"\n`; });
            downloadCsv(csv, 'waf-blocked-ips.csv');
        }

        function exportLoginAttempts()
        {
            let csv = 'Timestamp,IP Address,Email,Success,Blocked,Failure Reason\n';
            wafState.loginAttempts.forEach(a => { csv += `"${a.attemptedAt}","${a.ipAddress}","${a.targetEmail || ''}","${a.wasSuccessful}","${a.wasBlockedByWaf}","${(a.failureReason || '').replace(/"/g, '""')}"\n`; });
            downloadCsv(csv, 'waf-login-attempts.csv');
        }

        function downloadCsv(content, filename)
        {
            const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = filename; link.click();
        }





        // ====================================================================================================
        // UTILITIES
        // ====================================================================================================
        function escapeHtml(text)
        {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function formatDate(iso)
        {
            if (!iso) return '-';
            const d = new Date(iso);
            return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        async function formatTimeAgo(iso)
        {
            if (!iso) return '-';
            const diffMins = Math.floor((new Date() - new Date(iso)) / 60000);
            if (diffMins < 1) return '{{ "just now"|translate }}';
            if (diffMins < 60) await Localisation.translate("{minutesAgo}m ago", {"minutesAgo": diffMins});
            if (diffMins < 1440) await Localisation.translate("{hoursAgo}h ago", {"hoursAgo": Math.floor(diffMins / 60)});
            return await Localisation.translate("{daysAgo}d ago", {"daysAgo": Math.floor(diffMins / 1440)});
        }
    </script>
{% endblock %}
