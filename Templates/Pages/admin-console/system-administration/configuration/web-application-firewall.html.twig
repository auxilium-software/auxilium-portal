{% extends '/Bases/AdminConsole.html.twig' %}
{% block content %}

    <!-- Page Title -->
    <div class="page-title">
        <div class="page-title__text">
            <i class="ph-duotone ph-fire"></i> {{ "Web Application Firewall Management"|translate }}
            <span class="page-title__sub">{{ "Security Control Panel"|translate }}</span>
        </div>
        <div class="page-title__actions">
            <select id="statsPeriod" class="form-select" onchange="loadStatistics()" style="width: auto;">
                <option value="24">{{ "Last 24 Hours"|translate }}</option>
                <option value="48">{{ "Last 48 Hours"|translate }}</option>
                <option value="168">{{ "Last 7 Days"|translate }}</option>
                <option value="720">{{ "Last 30 Days"|translate }}</option>
                <option value="4380">{{ "Last 6 Months"|translate }}</option>
                <option value="8760">{{ "Last 1 Year"|translate }}</option>
            </select>
            <button type="button" class="form-btn" onclick="loadAllData()">
                <i class="ph-duotone ph-arrow-clockwise"></i> {{ "Refresh All"|translate }}
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card__value" id="statBlockedIps">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">Blocked IPs</div>
            <div class="stat-card__detail">
                <span id="statPermBlocks">{{ "Loading..."|translate }}</span> {{ "perm"|translate }}
                /
                <span id="statTempBlocks">{{ "Loading..."|translate }}</span> {{ "temp"|translate }}
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="statLockedUsers">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Locked Users"|translate }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="statFailedLogins">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Failed Logins"|translate }}</div>
            <div class="stat-card__detail" id="statFailedDetail">{{ "Loading..."|translate }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="statSuccessLogins">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Successful Logins"|translate }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="statDistinctIps">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Offending IPs"|translate }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value status-active" id="statWafStatus">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "WAF Status"|translate }}</div>
        </div>
    </div>

    <!-- Hourly Chart -->
    <div class="panel">
        <div class="panel__header">
            <span>
                <i class="ph-duotone ph-chart-bar"></i>
                {{ "Login Activity"|translate }}
            </span>
        </div>
        <div class="panel__body">
            <div id="activityChart" style="height: 200px; display: flex; align-items: flex-end; gap: 2px; padding: 10px 0;"></div>
            <div class="chart-legend">
                <span class="chart-legend__item"><span class="chart-legend__color" style="background: #4CAF50;"></span> {{ "Successful"|translate }}</span>
                <span class="chart-legend__item"><span class="chart-legend__color" style="background: #f44336;"></span> {{ "Failed"|translate }}</span>
                <span class="chart-legend__item"><span class="chart-legend__color" style="background: #333;"></span> {{ "Blocked"|translate }}</span>
            </div>
        </div>
    </div>

    <!-- Three Column Layout: Top Offenders, Top Targets, Alerts -->
    <div class="detail-grid detail-grid--three">
        <!-- Top Offending IPs -->
        <div class="panel">
            <div class="panel__header">
                <span>
                    <i class="ph-duotone ph-target"></i>
                    {{ "Top Offending IPs"|translate }}
                </span>
            </div>
            <div class="panel__body panel__body--compact" id="topOffendersBody">
                <div class="empty-state">{{ "Loading..."|translate }}</div>
            </div>
        </div>

        <!-- Top Targeted Users -->
        <div class="panel">
            <div class="panel__header">
                <span>
                    <i class="ph-duotone ph-user"></i>
                    {{ "Top Targeted Users"|translate }}
                </span>
            </div>
            <div class="panel__body panel__body--compact" id="topTargetsBody">
                <div class="empty-state">{{ "Loading..."|translate }}</div>
            </div>
        </div>

        <!-- Active Alerts -->
        <div class="panel">
            <div class="panel__header">
                <span>
                    <i class="ph-duotone ph-warning"></i>
                    {{ "Active Alerts"|translate }}
                </span>
                <span class="badge badge--inactive" id="alertCountBadge" style="margin-left: auto;">0</span>
            </div>
            <div class="panel__body panel__body--compact" id="alertsContainer">
                <div class="empty-state">{{ "Loading..."|translate }}</div>
            </div>
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="detail-grid">
        <!-- Left Column -->
        <div>
            <!-- IP Control Panel -->
            <div class="panel">
                <div class="panel__header">
                    <span>
                        <i class="ph-duotone ph-gear"></i>
                        {{ "IP Control"|translate }}
                    </span>
                </div>
                <div class="panel__body">
                    <div class="waf-control-form">
                        <div class="waf-form-row">
                            <div class="waf-form-field">
                                <label class="waf-label">{{ "IP Address:"|translate }}</label>
                                <input type="text" id="targetIpInput" class="form-input" placeholder="192.168.1.100" maxlength="45">
                            </div>
                            <div class="waf-form-field waf-form-field--wide">
                                <label class="waf-label">{{ "Reason:"|translate }}</label>
                                <input type="text" id="blockReasonInput" class="form-input" placeholder="Suspicious activity" maxlength="200">
                            </div>
                        </div>
                        <div class="waf-form-row">
                            <div class="waf-form-field">
                                <label class="waf-label">{{ "Block Type:"|translate }}</label>
                                <select id="blockTypeSelect" class="form-select">
                                    <option value="permanent">{{ "Permanent"|translate }}</option>
                                    <option value="temporary">{{ "Temporary"|translate }}</option>
                                </select>
                            </div>
                            <div class="waf-form-field" id="durationField" style="display: none;">
                                <label class="waf-label">{{ "Duration (min):"|translate }}</label>
                                <input type="number" id="blockDurationInput" class="form-input" value="60" min="1">
                            </div>
                            <div class="waf-form-field waf-form-field--buttons">
                                <button type="button" class="form-btn form-btn--danger" onclick="blockIp()">
                                    <i class="ph-duotone ph-prohibit"></i>
                                    {{ "Block"|translate }}
                                </button>
                                <button type="button" class="form-btn form-btn--primary" onclick="unblockIp()">
                                    <i class="ph-duotone ph-check-circle"></i>
                                    {{ "Unblock"|translate }}
                                </button>
                                <button type="button" class="form-btn" onclick="addToWhitelist()">
                                    <i class="ph-duotone ph-star"></i>
                                    {{ "Whitelist"|translate }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Blocked IPs Panel -->
            <div class="panel">
                <div class="panel__header">
                    <span>
                        <i class="ph-duotone ph-prohibit"></i>
                        {{ "Blocked IP Addresses"|translate }}
                    </span>
                    <label style="font-weight: normal; margin-left: auto; font-size: 10px;">
                        <input type="checkbox" id="showExpiredBlocks" onchange="refreshBlockedIps()"> {{ "Show Expired"|translate }}
                    </label>
                </div>
                <div class="panel__body" style="padding: 0; max-height: 350px; overflow-y: auto;">
                    <table class="admin-table admin-table--compact">
                        <thead>
                            <tr>
                                <th>{{ "Status"|translate }}</th>
                                <th>{{ "IP Address"|translate }}</th>
                                <th>{{ "Type"|translate }}</th>
                                <th>{{ "Reason"|translate }}</th>
                                <th>{{ "Blocked"|translate }}</th>
                                <th>{{ "Expires"|translate }}</th>
                                <th>{{ "Actions"|translate }}</th>
                            </tr>
                        </thead>
                        <tbody id="blockedIpsBody">
                            <tr><td colspan="7" class="empty-state">{{ "Loading..."|translate }}</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="panel__footer">
                    <span id="blockedIpsPagination" class="pagination__info"></span>
                    <div class="pagination__buttons" id="blockedIpsPaginationBtns"></div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div>
            <!-- Locked Out Users Panel -->
            <div class="panel">
                <div class="panel__header">
                    <span>
                        <i class="ph-duotone ph-lock"></i>
                        {{ "Locked Out Users"|translate }}
                    </span>
                    <label style="font-weight: normal; margin-left: auto; font-size: 10px;">
                        <input type="checkbox" id="showExpiredLockouts" onchange="refreshLockedUsers()"> {{ "Show Expired"|translate }}
                    </label>
                </div>
                <div class="panel__body" style="padding: 0; max-height: 250px; overflow-y: auto;">
                    <table class="admin-table admin-table--compact">
                        <thead>
                            <tr>
                                <th>{{ "Status"|translate }}</th>
                                <th>{{ "User"|translate }}</th>
                                <th>{{ "Reason"|translate }}</th>
                                <th>{{ "Locked At"|translate }}</th>
                                <th>{{ "Expires"|translate }}</th>
                                <th>{{ "Actions"|translate }}</th>
                            </tr>
                        </thead>
                        <tbody id="lockedUsersBody">
                            <tr><td colspan="6" class="empty-state">{{ "Loading..."|translate }}</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Whitelist Panel -->
            <div class="panel">
                <div class="panel__header">
                    <span>
                        <i class="ph-duotone ph-star"></i>
                        {{ "IP Whitelist"|translate }}
                    </span>
                </div>
                <div class="panel__body" style="padding: 0; max-height: 200px; overflow-y: auto;">
                    <table class="admin-table admin-table--compact">
                        <thead>
                            <tr>
                                <th>{{ "IP Address / CIDR"|translate }}</th>
                                <th style="width: 80px;">{{ "Actions"|translate }}</th>
                            </tr>
                        </thead>
                        <tbody id="whitelistBody">
                            <tr><td colspan="2" class="empty-state">{{ "Loading..."|translate }}</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Actions Panel -->
            <div class="panel">
                <div class="panel__header">
                    ⚡ Quick Actions
                </div>
                <div class="panel__body">
                    <div class="quick-actions-grid">
                        <button type="button" class="quick-button" onclick="exportBlockedIps()">
                            <i class="ph-duotone ph-download-simple"></i>
                            {{ "Export Blocked IPs"|translate }}
                        </button>
                        <button type="button" class="quick-button" onclick="exportLoginAttempts()">
                            <i class="ph-duotone ph-download-simple"></i>
                            {{ "Export Login Log"|translate }}
                        </button>
                        <button type="button" class="quick-button" onclick="viewIpDetails()">
                            <i class="ph-duotone ph-magnifying-glass"></i>
                            {{ "IP Lookup"|translate }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Login Attempts Log -->
    <div class="panel">
        <div class="panel__header">
            <span>
                <i class="ph-duotone ph-scroll"></i>
                {{ "Login Attempt Log"|translate }}
            </span>
        </div>
        <div class="toolbar" style="margin-bottom: 0; border: none; box-shadow: none;">
            <div class="toolbar__group">
                <span class="toolbar__label">{{ "Filter:"|translate }}</span>
                <select id="logFilterType" class="form-select" onchange="refreshLoginAttempts()">
                    <option value="">{{ "All Attempts"|translate }}</option>
                    <option value="failed">{{ "Failed Only"|translate }}</option>
                    <option value="success">{{ "Successful Only"|translate }}</option>
                    <option value="blocked">{{ "Blocked by WAF"|translate }}</option>
                </select>
            </div>
            <div class="toolbar__group">
                <span class="toolbar__label">{{ "IP:"|translate }}</span>
                <input type="text" id="logFilterIp" class="form-input form-input--search" placeholder="Filter by IP..." style="width: 120px;">
            </div>
            <div class="toolbar__group">
                <span class="toolbar__label">{{ "Email:"|translate }}</span>
                <input type="text" id="logFilterEmail" class="form-input form-input--search" placeholder="Filter by email..." style="width: 140px;">
            </div>
            <div class="toolbar__group">
                <span class="toolbar__label">{{ "Show:"|translate }}</span>
                <select id="logFilterCount" class="form-select" onchange="refreshLoginAttempts()">
                    <option value="50">{{ "50 entries"|translate }}</option>
                    <option value="100" selected>{{ "100 entries"|translate }}</option>
                    <option value="200">{{ "200 entries"|translate }}</option>
                </select>
            </div>
            <div class="toolbar__spacer"></div>
            <div class="toolbar__group">
                <label style="font-size: 10px;">
                    <input type="checkbox" id="autoRefreshCheck" checked onchange="toggleAutoRefresh()"> {{ "Auto-refresh"|translate }}
                </label>
            </div>
            <button type="button" class="form-btn form-btn--sm" onclick="refreshLoginAttempts()">
                <i class="ph-duotone ph-arrow-clockwise"></i>
                {{ "Refresh"|translate }}
            </button>
        </div>
        <div class="table-container" style="max-height: 400px; overflow-y: auto;">
            <table class="admin-table admin-table--compact">
                <thead>
                    <tr>
                        <th style="width: 140px;">{{ "Timestamp"|translate }}</th>
                        <th style="width: 70px;">{{ "Status"|translate }}</th>
                        <th style="width: 130px;">{{ "IP Address"|translate }}</th>
                        <th>{{ "Email"|translate }}</th>
                        <th>{{ "Failure Reason"|translate }}</th>
                        <th style="width: 60px;">{{ "Actions"|translate }}</th>
                    </tr>
                </thead>
                <tbody id="loginAttemptsBody">
                    <tr><td colspan="6" class="empty-state">{{ "Loading..."|translate }}</td></tr>
                </tbody>
            </table>
        </div>
        <div class="panel__footer">
            <span class="pagination__info" id="logPaginationInfo">{{ "Showing 0 entries"|translate }}</span>
            <span id="lastRefreshTime" style="font-size: 10px; color: #666;">{{ "Last refresh: Loading..."|translate }}</span>
            <div class="pagination__buttons" id="logPaginationBtns"></div>
        </div>
    </div>

    <!-- IP Details Modal -->
    <div class="confirm-overlay" id="ipDetailsOverlay">
        <div class="confirm-dialog confirm-dialog--wide">
            <div class="error-box">
                <div class="error-box__header">
                    <span class="error-box__header-icon"><i class="ph-duotone ph-magnifying-glass"></i></span>
                    {{ "IP Details:"|translate }} <span id="ipDetailsTitle">{{ "Loading..." }}</span>
                </div>
                <div class="error-box__body" style="max-height: 500px; overflow-y: auto;">
                    <div id="ipDetailsContent">{{ "Loading..."|translate }}</div>
                </div>
                <div class="error-box__footer">
                    <button type="button" class="error-box__btn" onclick="closeIpDetails()">{{ "Close"|translate }}</button>
                    <button type="button" class="error-box__btn error-box__btn--danger" id="ipDetailsBlockBtn" onclick="blockFromDetails()">{{ "Block IP"|translate }}</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-dialog">
            <div class="error-box">
                <div class="error-box__header">
                    <span class="error-box__header-icon" id="confirmIcon"><i class="ph-duotone ph-warning"></i></span>
                    <span id="confirmTitle">{{ "Confirm Action"|translate }}</span>
                </div>
                <div class="error-box__body">
                    <div class="error-box__message">
                        <div class="error-box__text" id="confirmMessage">{{ "Are you sure?"|translate }}</div>
                        <div id="confirmReasonField" style="margin-top: 12px; display: none;">
                            <label class="waf-label">{{ "Reason (optional):"|translate }}</label>
                            <input type="text" id="confirmReasonInput" class="form-input" placeholder="{{ "Reason for this action"|translate }}">
                        </div>
                    </div>
                </div>
                <div class="error-box__footer">
                    <button type="button" class="error-box__btn" onclick="closeConfirmDialog()">{{ "Cancel"|translate }}</button>
                    <button type="button" class="error-box__btn error-box__btn--primary" id="confirmActionBtn" onclick="executeConfirmedAction()">{{ "Confirm"|translate }}</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .waf-control-form { display: flex; flex-direction: column; gap: 10px; }
        .waf-form-row { display: flex; gap: 12px; align-items: flex-end; }
        .waf-form-field { display: flex; flex-direction: column; gap: 4px; }
        .waf-form-field--wide { flex: 1; }
        .waf-form-field--buttons { display: flex; gap: 6px; }
        .waf-label { font-size: 10px; color: #444; font-weight: bold; }

        .detail-grid--three { grid-template-columns: repeat(3, 1fr); }
        @media (max-width: 1200px) { .detail-grid--three { grid-template-columns: 1fr; } }

        .stat-card__detail { font-size: 9px; color: #666; margin-top: 2px; }
        .panel__body--compact { padding: 0; max-height: 250px; overflow-y: auto; }
        .panel__footer { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: #f5f5f5; border-top: 1px solid #ddd; font-size: 10px; }

        .waf-list-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border-bottom: 1px solid #eee; }
        .waf-list-item:last-child { border-bottom: none; }
        .waf-list-item__main { display: flex; flex-direction: column; gap: 2px; }
        .waf-list-item__title { font-family: "Courier New", monospace; font-size: 11px; }
        .waf-list-item__detail { font-size: 9px; color: #666; }
        .waf-list-item__badge { font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 3px; background: #f44336; color: white; }
        .waf-list-item__badge--warning { background: #ff9800; }
        .waf-list-item__badge--blocked { background: #333; }

        .waf-alert-item { padding: 8px 10px; border-bottom: 1px solid #eee; border-left: 3px solid #cc0000; background: linear-gradient(90deg, #ffe0e0 0%, #fff 100%); }
        .waf-alert-item:last-child { border-bottom: none; }
        .waf-alert-item--warning { border-left-color: #cc8800; background: linear-gradient(90deg, #fff8e0 0%, #fff 100%); }
        .waf-alert-item--info { border-left-color: #0066cc; background: linear-gradient(90deg, #e0f0ff 0%, #fff 100%); }
        .waf-alert-item__message { font-size: 11px; }

        .chart-legend { display: flex; justify-content: center; gap: 20px; font-size: 10px; padding-top: 10px; border-top: 1px solid #eee; }
        .chart-legend__item { display: flex; align-items: center; gap: 4px; }
        .chart-legend__color { width: 12px; height: 12px; border-radius: 2px; }
        .chart-bar-group { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 0; }
        .chart-bar-stack { display: flex; flex-direction: column-reverse; width: 100%; max-width: 20px; }
        .chart-bar { width: 100%; min-height: 1px; }
        .chart-bar--success { background: #4CAF50; }
        .chart-bar--failed { background: #f44336; }
        .chart-bar--blocked { background: #333; }
        .chart-label { font-size: 8px; color: #666; margin-top: 4px; writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); max-height: 50px; overflow: hidden; }

        .quick-actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .confirm-dialog--wide { max-width: 700px; width: 90%; }
        .empty-state { text-align: center; color: #666; padding: 20px; }
        .waf-ip-cell { font-family: "Courier New", monospace; font-size: 11px; }
        .waf-truncate { max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .pagination__buttons { display: flex; gap: 4px; }
        .pagination__buttons button { padding: 2px 8px; font-size: 10px; }

        @media (max-width: 768px) {
            .waf-form-row { flex-direction: column; align-items: stretch; }
            .waf-form-field--buttons { flex-wrap: wrap; }
            .quick-actions-grid { grid-template-columns: 1fr; }
        }
    </style>

{% endblock %}

{% block scripts %}
    <script>
        const api = new APIInteractions();

        const wafState = {
            statistics: null,
            blockedIps: [],
            blockedIpsPage: 1,
            blockedIpsTotal: 0,
            lockedUsers: [],
            whitelist: [],
            loginAttempts: [],
            loginAttemptsPage: 1,
            loginAttemptsTotal: 0,
            autoRefreshInterval: null,
            pendingAction: null
        };

        document.addEventListener('DOMContentLoaded', function() {
            loadAllData();
            toggleAutoRefresh();
            setupEventListeners();
        });

        function setupEventListeners()
        {
            document.getElementById('blockTypeSelect').addEventListener('change', function()
            {
                document.getElementById('durationField').style.display = this.value === 'temporary' ? 'block' : 'none';
            });
            document.getElementById('logFilterIp').addEventListener('keypress', e => { if (e.key === 'Enter') refreshLoginAttempts(); });
            document.getElementById('logFilterEmail').addEventListener('keypress', e => { if (e.key === 'Enter') refreshLoginAttempts(); });
            document.getElementById('targetIpInput').addEventListener('keypress', e => { if (e.key === 'Enter') blockIp(); });
        }

        function loadAllData()
        {
            loadStatistics();
            refreshBlockedIps();
            refreshLockedUsers();
            refreshWhitelist();
            refreshLoginAttempts();
        }





        // ====================================================================================================
        // STATISTICS
        // ====================================================================================================
        async function loadStatistics()
        {
            try
            {
                const hours = document.getElementById('statsPeriod').value;
                const [status, data] = await api.API_GET(`/api/v3/web-application-firewall/statistics?hoursBack=${hours}`);
                if (status !== 200) throw new Error('{{ "Failed to load statistics"|translate }}');
                wafState.statistics = data;
                await renderStatistics();
                await renderChart();
                renderTopOffenders();
                renderTopTargets();
                updateAlerts();
            }
            catch (err)
            {
                console.error('{{ "Failed to load statistics:"|translate }}', err);
            }
        }

        async function renderStatistics()
        {
            const s = wafState.statistics;
            if (!s) return;
            document.getElementById('statBlockedIps').textContent = s.currentlyBlockedIps;
            document.getElementById('statPermBlocks').textContent = s.permanentlyBannedIps;
            document.getElementById('statTempBlocks').textContent = s.temporarilyBlockedIps;
            document.getElementById('statLockedUsers').textContent = s.lockedOutUsers;
            document.getElementById('statFailedLogins').textContent = s.failedLoginAttempts;
            document.getElementById('statFailedDetail').textContent = await Localisation.translate(
                "{count} blocked by WAF",
                {
                    "{count}": s.blockedByWafAttempts
                }
            );
            document.getElementById('statSuccessLogins').textContent = s.successfulLoginAttempts;
            document.getElementById('statDistinctIps').textContent = s.distinctOffendingIps;

            const wafStatusEl = document.getElementById('statWafStatus');
            wafStatusEl.textContent = s.wafEnabled ? '{{ "Active"|translate }}' : '{{ "Disabled"|translate }}';
            wafStatusEl.className = 'stat-card__value ' + (s.wafEnabled ? 'status-active' : 'status-error');

            const failedEl = document.getElementById('statFailedLogins');
            failedEl.className = 'stat-card__value' + (s.failedLoginAttempts > 100 ? ' status-error' : s.failedLoginAttempts > 20 ? ' status-warning' : '');
        }

        async function renderChart()
        {
            const s = wafState.statistics;
            if (!s?.hourlyBreakdown?.length) {
                document.getElementById('activityChart').innerHTML = '<div class="empty-state">{{ "No data available"|translate }}</div>';
                return;
            }
            const maxTotal = Math.max(...s.hourlyBreakdown.map(h => h.totalAttempts), 1);
            const chartHeight = 180;
            let html = '';
            for (const hour of s.hourlyBreakdown)
            {
                const successHeight = ((hour.totalAttempts - hour.failedAttempts) / maxTotal) * chartHeight;
                const failedHeight = ((hour.failedAttempts - hour.blockedAttempts) / maxTotal) * chartHeight;
                const blockedHeight = (hour.blockedAttempts / maxTotal) * chartHeight;
                const date = new Date(hour.hour);
                const label = date.getHours().toString().padStart(2, '0') + ':00';
                const title = await Localisation.translate(
                    "{date}: {totalAttempts} total",
                    {
                        "{date}": date.toLocaleString(),
                        "{totalAttempts}": hour.totalAttempts,
                    }
                );

                html += `<div class="chart-bar-group" title="${title}">
                    <div class="chart-bar-stack">
                        <div class="chart-bar chart-bar--success" style="height:${successHeight}px;"></div>
                        <div class="chart-bar chart-bar--failed" style="height:${failedHeight}px;"></div>
                        <div class="chart-bar chart-bar--blocked" style="height:${blockedHeight}px;"></div>
                    </div>
                    <div class="chart-label">${label}</div>
                </div>`;
            }
            document.getElementById('activityChart').innerHTML = html;
        }

