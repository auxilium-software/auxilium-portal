{% extends '/Bases/AdminConsole.html.twig' %}
{% block content %}
    <div class="page-title">
        <div class="page-title__text">
            <i class="ph ph-checks"></i>
            {{ "Aux::TaskRunner"|translate }}
            <span class="page-title__sub">{{ "Monitor the background task runner"|translate }}</span>
        </div>
        <div class="page-title__actions">
            <button type="button" class="form-btn" onclick="loadAll()">
                <i class="ph ph-arrow-clockwise"></i> {{ "Refresh"|translate }}
            </button>
        </div>
    </div>

    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card__value" id="stat-uptime">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Uptime"|translate }}</div>
            <div class="stat-card__change" id="stat-uptime-sub">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-cpu">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "CPU Usage"|translate }}</div>
            <div class="stat-card__change" id="stat-cpu-change">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-mem">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Memory (RSS)"|translate }}</div>
            <div class="stat-card__change" id="stat-mem-change">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-tpq">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Thread Pool Queue"|translate }}</div>
            <div class="stat-card__change">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-gc">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Time in GC"|translate }}</div>
            <div class="stat-card__change">&nbsp;</div>
        </div>
    </div>

    <div class="chart-grid chart-grid--2col">
        <div class="chart-container">
            <div class="chart-container__header">{{ "CPU Usage Over Time"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="cpuChart"></canvas></div></div>
            <div class="chart-container__footer" id="cpuFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
        <div class="chart-container">
            <div class="chart-container__header">{{ "Memory Usage Over Time"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="memChart"></canvas></div></div>
            <div class="chart-container__footer" id="memFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
        <div class="chart-container">
            <div class="chart-container__header">{{ "GC Collections (per minute)"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="gcChart"></canvas></div></div>
            <div class="chart-container__footer" id="gcFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
        <div class="chart-container">
            <div class="chart-container__header">{{ "Time In GC / Thread Pool Queue"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="runtimeChart"></canvas></div></div>
            <div class="chart-container__footer" id="runtimeFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        const dash = new ServiceMetricsDashboard();

        async function loadAll()
        {
            try
            {
                const m = await dash.load([
                    'TaskRunner_UptimeInSeconds', 'TaskRunner_CpuUsageAsPercentage', 'TaskRunner_MemoryUsageInBytes',
                    'TaskRunner_ThreadPoolQueueLength', 'TaskRunner_TimeInGcAsPercentage',
                    'TaskRunner_Gen0CollectionsPerMinute', 'TaskRunner_Gen1CollectionsPerMinute', 'TaskRunner_Gen2CollectionsPerMinute',
                ]);

                dash.statValue('stat-uptime', dash.latest(m.TaskRunner_UptimeInSeconds), MetricFmt.duration);
                dash.statSub('stat-uptime-sub', '{{ "Last reading"|translate }}: ' + MetricFmt.date(dash.lastAt(m.TaskRunner_UptimeInSeconds)));
                dash.statValue('stat-cpu', dash.latest(m.TaskRunner_CpuUsageAsPercentage), MetricFmt.percent);
                dash.statChange('stat-cpu-change', m.TaskRunner_CpuUsageAsPercentage, MetricFmt.percent, '{{ "since last reading"|translate }}', '{{ "No change"|translate }}');
                dash.statValue('stat-mem', dash.latest(m.TaskRunner_MemoryUsageInBytes), MetricFmt.bytes);
                dash.statChange('stat-mem-change', m.TaskRunner_MemoryUsageInBytes, MetricFmt.bytes, '{{ "since last reading"|translate }}', '{{ "No change"|translate }}');
                dash.statValue('stat-tpq', dash.latest(m.TaskRunner_ThreadPoolQueueLength), MetricFmt.count);
                dash.statValue('stat-gc', dash.latest(m.TaskRunner_TimeInGcAsPercentage), MetricFmt.percent);

                dash.lineChart('cpuChart', m.TaskRunner_CpuUsageAsPercentage, { label: '{{ "CPU"|translate }}', fmt: MetricFmt.percent, y: MetricAxis.percent });
                dash.lineChart('memChart', m.TaskRunner_MemoryUsageInBytes,   { label: '{{ "Memory"|translate }}', fmt: MetricFmt.bytes, y: MetricAxis.bytes });

                dash.multiLineChart('gcChart', [
                    { label: 'Gen 0', metrics: m.TaskRunner_Gen0CollectionsPerMinute },
                    { label: 'Gen 1', metrics: m.TaskRunner_Gen1CollectionsPerMinute },
                    { label: 'Gen 2', metrics: m.TaskRunner_Gen2CollectionsPerMinute },
                ], { fmt: MetricFmt.count, y: MetricAxis.count });

                dash.multiLineChart('runtimeChart', [
                    { label: '{{ "Time in GC %"|translate }}', metrics: m.TaskRunner_TimeInGcAsPercentage, color: '#8e44ad' },
                    { label: '{{ "Thread Pool Queue"|translate }}', metrics: m.TaskRunner_ThreadPoolQueueLength, color: '#16a085' },
                ], { fmt: MetricFmt.decimal, y: { beginAtZero: true } });

                dash.footer('cpuFooter', m.TaskRunner_CpuUsageAsPercentage, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
                dash.footer('memFooter', m.TaskRunner_MemoryUsageInBytes, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
                dash.footer('gcFooter', m.TaskRunner_Gen0CollectionsPerMinute, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
                dash.footer('runtimeFooter', m.TaskRunner_TimeInGcAsPercentage, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
            }
            catch (err) { await dash.fail(err, 'Task Runner metrics'); }
        }

        document.addEventListener('DOMContentLoaded', loadAll);
    </script>
{% endblock %}
