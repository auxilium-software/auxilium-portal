{% extends '/Bases/AdminConsole.html.twig' %}
{% block content %}
    <div class="page-title">
        <div class="page-title__text">
            <i class="ph ph-hard-drive"></i>
            {{ "Aux::LFS"|translate }}
            <span class="page-title__sub">{{ "Monitor the Large File System (AUX::LFS)"|translate }}</span>
        </div>
        <div class="page-title__actions">
            <button type="button" class="form-btn" onclick="loadAll()">
                <i class="ph ph-arrow-clockwise"></i> {{ "Refresh"|translate }}
            </button>
        </div>
    </div>

    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card__value" id="stat-status">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Status"|translate }}</div>
            <div class="stat-card__change" id="stat-status-sub">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-size">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "LFS Size"|translate }}</div>
            <div class="stat-card__change" id="stat-size-change">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-probe">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Write Probe Latency"|translate }}</div>
            <div class="stat-card__change">&nbsp;</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value" id="stat-volumes">{{ "Loading..."|translate }}</div>
            <div class="stat-card__label">{{ "Volumes Monitored"|translate }}</div>
            <div class="stat-card__change">&nbsp;</div>
        </div>
    </div>

    <div class="chart-grid chart-grid--2col">
        <div class="chart-container">
            <div class="chart-container__header">{{ "LFS Size Over Time"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="sizeChart"></canvas></div></div>
            <div class="chart-container__footer" id="sizeFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
        <div class="chart-container">
            <div class="chart-container__header">{{ "Disk Free By Volume"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="diskChart"></canvas></div></div>
            <div class="chart-container__footer" id="diskFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
        <div class="chart-container">
            <div class="chart-container__header">{{ "Write Probe Latency"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="probeChart"></canvas></div></div>
            <div class="chart-container__footer" id="probeFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
        <div class="chart-container">
            <div class="chart-container__header">{{ "Writable Status"|translate }}</div>
            <div class="chart-container__body"><div class="chart-canvas-wrapper chart-canvas-wrapper--md"><canvas id="writableChart"></canvas></div></div>
            <div class="chart-container__footer" id="writableFooter"><span></span><span>{{ "Loading..."|translate }}</span></div>
        </div>
    </div>

    <div class="panel">
        <div class="panel__header"><span><i class="ph ph-hard-drive"></i> {{ "Volume Free Space"|translate }}</span></div>
        <div class="panel__body" style="padding: 0; max-height: 300px; overflow-y: auto;">
            <table class="admin-table admin-table--compact">
                <thead><tr>
                    <th>{{ "Volume"|translate }}</th>
                    <th>{{ "Free"|translate }}</th>
                    <th>{{ "Total"|translate }}</th>
                    <th>{{ "Used"|translate }}</th>
                </tr></thead>
                <tbody id="volumeBody">
                <tr><td colspan="4" style="text-align:center;color:#666;padding:20px;">{{ "Loading..."|translate }}</td></tr>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        const dash = new ServiceMetricsDashboard();

        async function loadAll()
        {
            try
            {
                const m = await dash.load([
                    'Lfs_IsWritable', 'Lfs_ProbeLatencyInMs', 'Lfs_SizeInBytes',
                    'Host_DiskFreeInBytes', 'Host_DiskTotalInBytes',
                ]);

                dash.statStatus('stat-status', dash.latest(m.Lfs_IsWritable), '{{ "Writable"|translate }}', '{{ "Read-only"|translate }}');
                dash.statSub('stat-status-sub', '{{ "Probe"|translate }}: ' + MetricFmt.ms(dash.latest(m.Lfs_ProbeLatencyInMs)));
                dash.statValue('stat-size', dash.latest(m.Lfs_SizeInBytes), MetricFmt.bytes);
                dash.statChange('stat-size-change', m.Lfs_SizeInBytes, MetricFmt.bytes, '{{ "since last reading"|translate }}', '{{ "No change"|translate }}');
                dash.statValue('stat-probe', dash.latest(m.Lfs_ProbeLatencyInMs), MetricFmt.ms);

                const freeByVolume = dash.groupByLabel(m.Host_DiskFreeInBytes);
                dash.statValue('stat-volumes', freeByVolume.length, MetricFmt.count);

                dash.lineChart('sizeChart', m.Lfs_SizeInBytes, { label: '{{ "Size"|translate }}', fmt: MetricFmt.bytes, y: MetricAxis.bytes });
                dash.multiLineChart('diskChart',
                        freeByVolume.map(v => ({ label: v.label, metrics: v.metrics })),
                        { fmt: MetricFmt.bytes, y: MetricAxis.bytes }
                );
                dash.lineChart('probeChart', m.Lfs_ProbeLatencyInMs, { label: '{{ "Latency"|translate }}', fmt: MetricFmt.ms, color: '#16a085', y: MetricAxis.ms });
                dash.lineChart('writableChart', m.Lfs_IsWritable, { label: '{{ "Writable"|translate }}', fmt: v => v === 1 ? '{{ "Yes"|translate }}' : '{{ "No"|translate }}', color: '#5cb85c', y: { min: 0, max: 1, ticks: { stepSize: 1, callback: v => v === 1 ? '{{ "Yes"|translate }}' : '{{ "No"|translate }}' } } });

                dash.footer('sizeFooter', m.Lfs_SizeInBytes, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
                dash.footer('diskFooter', m.Host_DiskFreeInBytes, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
                dash.footer('probeFooter', m.Lfs_ProbeLatencyInMs, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');
                dash.footer('writableFooter', m.Lfs_IsWritable, '{{ "readings"|translate }}', '{{ "Last updated"|translate }}');

                const totalByLabel = {};
                dash.groupByLabel(m.Host_DiskTotalInBytes).forEach(v => totalByLabel[v.label] = dash.latest(v.metrics));
                const tbody = document.getElementById('volumeBody');
                if (!freeByVolume.length)
                {
                    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#666;padding:20px;">{{ "No data yet"|translate }}</td></tr>';
                }
                else
                {
                    tbody.innerHTML = freeByVolume.map(v => {
                        const free = dash.latest(v.metrics);
                        const total = totalByLabel[v.label] ?? null;
                        const usedPct = (free !== null && total) ? (((total - free) / total) * 100).toFixed(1) + '%' : '-';
                        return `<tr><td>${v.label}</td><td>${MetricFmt.bytes(free)}</td><td>${MetricFmt.bytes(total)}</td><td>${usedPct}</td></tr>`;
                    }).join('');
                }
            }
            catch (err) { await dash.fail(err, 'LFS metrics'); }
        }

        document.addEventListener('DOMContentLoaded', loadAll);
    </script>
{% endblock %}
