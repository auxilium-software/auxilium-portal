{% extends '/Bases/AdminConsole.html.twig' %}

{% block content %}
    <div class="page-title">
        <div class="page-title__text">
            <i class="ph-duotone ph-git-merge"></i> {{ "Merge Cases"|translate }}
            <span class="page-title__sub">{{ "Combine a duplicate case into the case you keep"|translate }}</span>
        </div>
        <div class="page-title__actions">
            <button class="form-btn" onclick="resetEverything()">
                <i class="ph-duotone ph-arrow-counter-clockwise"></i>
                {{ "Start Over"|translate }}
            </button>
        </div>
    </div>

    {# ===== STEP INDICATOR ===== #}
    <div class="merge-steps">
        <div class="merge-steps__item is-active" id="Step-1">
            <span class="merge-steps__num">1</span>
            {{ "Select Cases"|translate }}
        </div>
        <div class="merge-steps__item" id="Step-2">
            <span class="merge-steps__num">2</span>
            {{ "Resolve Conflicts"|translate }}
        </div>
        <div class="merge-steps__item" id="Step-3">
            <span class="merge-steps__num">3</span>
            {{ "Review and Merge"|translate }}
        </div>
    </div>

    {# ===== STEP 1: FIND CASES ===== #}
    <div class="toolbar">
        <div class="toolbar__group">
            <span class="toolbar__label">{{ "Search:"|translate }}</span>
            <input type="text" class="form-input form-input--search" placeholder="{{ "Title or description..."|translate }}" id="caseSearch">
            <button class="form-btn" onclick="applyFilters()">
                <i class="ph-duotone ph-magnifying-glass"></i>
                {{ "Find"|translate }}
            </button>
        </div>
        <div class="toolbar__separator"></div>
        <div class="toolbar__group">
            <span class="toolbar__label">{{ "Status"|translate }}:</span>
            <select class="form-select" id="filterStatus">
                <option value="">{{ "All"|translate }}</option>
                <option value="open">{{ "Open"|translate }}</option>
                <option value="closed">{{ "Closed"|translate }}</option>
                <option value="staging">{{ "Staging"|translate }}</option>
                <option value="archived">{{ "Archived"|translate }}</option>
            </select>
        </div>
        <div class="toolbar__spacer"></div>
        <div class="toolbar__group">
            <button class="form-btn form-btn--sm" onclick="resetFilters()">✕ {{ "Clear"|translate }}</button>
            <span class="toolbar__label" id="resultCount"></span>
        </div>
    </div>

    <div class="table-container">
        <table class="admin-table" id="casesTable">
            <caption>{{ "Tick the two cases that are duplicates of each other"|translate }}</caption>
            <thead>
            <tr>
                <th class="cell-checkbox"></th>
                <th class="is-sortable" data-sort="title">{{ "Case"|translate }}</th>
                <th>{{ "Status"|translate }}</th>
                <th>{{ "Sensitivity"|translate }}</th>
                <th>{{ "Clients"|translate }}</th>
                <th class="is-sortable is-sorted-desc" data-sort="createdAt">{{ "Created At"|translate }}</th>
                <th>{{ "Controls"|translate }}</th>
            </tr>
            </thead>
            <tbody id="CasesTableBody">
            </tbody>
        </table>
    </div>

    <div class="pagination" id="Pagination">
    </div>

    {# ===== MERGE SET ===== #}
    <div class="panel merge-section">
        <div class="panel__header">
            <span><i class="ph-duotone ph-stack"></i> {{ "Cases to Merge"|translate }}</span>
            <span id="mergeSetCount"></span>
        </div>
        <div class="panel__body" id="mergeSetBody">
        </div>
        <div class="panel__footer merge-footer--split">
            <span>
                {{ "The primary case is kept. Everything from the other case is moved into it."|translate }}
            </span>
            <button class="form-btn form-btn--primary" id="compareBtn" onclick="loadComparison()" disabled>
                <i class="ph-duotone ph-arrows-left-right"></i>
                {{ "Compare Selected Cases"|translate }}
            </button>
        </div>
    </div>

    {# ===== STEP 2: RESOLVE CONFLICTS ===== #}
    <div class="panel merge-section" id="resolvePanel" style="display:none;">
        <div class="panel__header">
            <span>
                <i class="ph-duotone ph-scales"></i>
                {{ "Resolve Conflicts"|translate }}
            </span>
            <label class="merge-toggle">
                <input type="checkbox" id="showIdentical" onchange="renderResolveTable()">
                {{ "Show identical fields"|translate }}
            </label>
        </div>
        <div class="panel__body">
            <div class="merge-notice merge-notice--info">
                <i class="ph-duotone ph-info"></i>
                <div>
                    {{ "Where the cases have conflicting data, pick which value the merged case should keep.  Clients, Caseworkers, Todos, Files, Messages, Timeline entries, and Additional Properties are always moved across, never discarded."|translate }}
                </div>
            </div>
            <div class="table-container">
                <table class="admin-table merge-resolve" id="resolveTable">
                    <thead id="resolveTableHead"></thead>
                    <tbody id="resolveTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    {# ===== STEP 3: REVIEW ===== #}
    <div class="panel merge-section" id="reviewPanel" style="display:none;">
        <div class="panel__header">
            <span>
                <i class="ph-duotone ph-clipboard-text"></i>
                {{ "Review and Merge"|translate }}
            </span>
        </div>
        <div class="panel__body">
            <div class="detail-grid merge-review-grid">
                <div>
                    <dl class="detail-list detail-list--wide" id="reviewSummary"></dl>
                </div>
                <div id="reviewWarnings"></div>
            </div>

            <dl class="detail-list detail-list--wide">
                <dt>{{ "Other case afterwards"|translate }}</dt>
                <dd>{{ "Retired: hidden from lists and pointing to the kept case. Its history and audit log are kept."|translate }}</dd>

                <dt>
                    <label for="mergeReason">
                        {{ "Reason for merge"|translate }}
                    </label>
                </dt>
                <dd>
                    <textarea class="form-input merge-textarea" id="mergeReason" maxlength="1000" placeholder="{{ "e.g. Client signed up twice with different email addresses"|translate }}" oninput="updateMergeButtonState()"></textarea>
                    <div class="merge-hint">
                        {{ "Recorded on the merge record and on the kept case's timeline. At least 10 characters."|translate }}
                    </div>
                </dd>
            </dl>

            <div id="clientAcknowledgementRow" style="display:none;">
                <label class="merge-ack">
                    <input type="checkbox" id="clientAcknowledgement" onchange="updateMergeButtonState()">
                    {{ "I have checked that these cases are about the same person and it is safe for every client listed to see all of the merged material."|translate }}
                </label>
            </div>
        </div>
        <div class="panel__footer merge-footer">
            <button class="form-btn" onclick="loadComparison()">
                <i class="ph-duotone ph-arrows-clockwise"></i>
                {{ "Reload Comparison"|translate }}
            </button>
            <button class="form-btn form-btn--danger" id="mergeBtn" onclick="openConfirm()" disabled>
                <i class="ph-duotone ph-git-merge"></i>
                {{ "Merge Cases"|translate }}
            </button>
        </div>
    </div>

    {# ===== SUCCESS ===== #}
    <div class="panel merge-section" id="successPanel" style="display:none;">
        <div class="panel__header">
            <span>
                <i class="ph-duotone ph-check-circle"></i>
                {{ "Merge Complete"|translate }}
            </span>
        </div>
        <div class="panel__body">
            <div class="merge-notice merge-notice--success">
                <i class="ph-duotone ph-check-circle"></i>
                <div id="successMessage"></div>
            </div>
        </div>
        <div class="panel__footer merge-footer">
            <button class="form-btn" onclick="resetEverything()">{{ "Merge More Cases"|translate }}</button>
            <a class="form-btn form-btn--primary" id="viewMergedCaseBtn" href="#">
                <i class="ph-duotone ph-briefcase"></i>
                {{ "View Merged Case"|translate }}
            </a>
        </div>
    </div>

    {# ===== CONFIRMATION DIALOG ===== #}
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-dialog">
            <div class="panel">
                <div class="panel__header">
                    <span>
                        <i class="ph-duotone ph-warning"></i>
                        {{ "Confirm Merge"|translate }}
                    </span>
                </div>
                <div class="panel__body">
                    <div class="merge-confirm__summary">
                        <div class="merge-confirm__icon"><i class="ph-duotone ph-git-merge"></i></div>
                        <div>
                            <div class="merge-confirm__title" id="confirmTitle"></div>
                            <div class="merge-confirm__desc">
                                {{ "The other case will be retired. This cannot be undone from the administration console."|translate }}
                            </div>
                        </div>
                    </div>
                    <div class="merge-notice merge-notice--warning">
                        <i class="ph-duotone ph-key"></i>
                        <div>
                            {{ "This action requires two-factor authentication."|translate }}
                        </div>
                    </div>
                    <div class="merge-totp">
                        <label for="totpInput">
                            {{ "Authenticator Code:"|translate }}
                        </label>
                        <input type="text"
                               id="totpInput"
                               class="form-input"
                               maxlength="6"
                               placeholder="000000"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               pattern="[0-9]{6}">
                    </div>
                    <div class="merge-field-error" id="totpError" style="display:none;"></div>
                </div>
                <div class="panel__footer merge-footer">
                    <button class="form-btn" id="confirmCancelBtn" onclick="closeConfirm()">
                        {{ "Cancel"|translate }}
                    </button>
                    <button class="form-btn form-btn--danger" id="confirmBtn" onclick="executeMerge()">
                        {{ "Merge"|translate }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast" id="toast">
        <span class="toast__icon" id="toastIcon">✓</span>
        <span id="toastMessage"></span>
    </div>
{% endblock %}
