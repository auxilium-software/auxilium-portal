{% extends "/Bases/StandardWebPage.html.twig" %}

{% block title %}{{ "home" | translate }}{% endblock %}

{% block content %}

    <div>
        <div class="inner-content">
            <div class="navigation-breadcrumb-container">
                <a class="navigation-breadcrumb" href="/dashboard">{{ "home" | translate }}</a>
            </div>

            <h1>
                {{ "{greeting}, {username}"|translate({
                    '{greeting}': ("Good "~TimePeriod)|translate,
                    '{username}': "Cerys",
                })|raw }}
            </h1>

            {% for paa in paa_output %}
                <div class="todo-box"><h4>{{ paa.action.short_description }}</h4><p><a href="{{ paa.accept_link }}">{{ "accept" | translate }}<span class="inline-icon internal-link-marker-icon"></span></a><br /><a href="{{ paa.deny_link }}">{{ "deny" | translate }}<span class="inline-icon internal-link-marker-icon"></span></a></p></div>
            {% endfor %}

            <a href="/me" class="navigational-link">{{ "Manage my Account" | translate | ndsentence }}</a><br />
            <a href="/new-case" class="navigational-link">{{ "Open a New Case" | translate | ndsentence }}</a><br />
            {% if _IS_ADMIN_ %}
                <a href="/system" class="navigational-link">{{ "System Settings" | translate | ndsentence }}</a><br />
                <a href="/all-cases" class="navigational-link">{{ "All Cases" | translate | ndsentence }}</a><br />
                <a href="/all-users" class="navigational-link">{{ "All Users" | translate | ndsentence }}</a><br />
                <a href="/map" class="navigational-link">{{ "Map" | translate | ndsentence }}</a><br />
            {% endif %}

            <div class="large-spacer"></div>
            <div class="separator"></div>


            {% set local_breadcrumbs = breadcrumbs %}

            <div class="right-preferential-box">
                <div class="marked-section">
                    {% set ltid = "CASES_BOX" %}
                    <h2 class="heading-of-hideable-content">
                        {{ "My Cases" | translate }}
                        <a href="javascript:toggle_hidden_box('{{ ltid }}');">
                            <span id="hidden_box_{{ ltid }}_toggle_button" class="inline-icon-low-margin expand-more-icon" style="display: none;">
                            </span>
                        </a>
                    </h2>
                    <div id="hidden_box_{{ ltid }}" class="logical-box">
                        <ul class="collection-list" id="cases-list-container">
                            <li><em>{{ "Loading cases..."|translate }}</em></li>
                        </ul>
                    </div>
                </div>
            </div>
            <script>toggle_hidden_box("{{ ltid }}");toggle_hidden_box("{{ ltid }}");</script>


            {% set ltid = "TOP_FOLD_MESSAGE_BOX" %}

            <div class="left-preferential-box">
                <div class="marked-section">
                    {% set latest_comms = current_user.getLatestCommunications(3) %}
                    <h2 class="heading-of-hideable-content">
                        {{ "My Messages" | translate }}
                        <a href="javascript:toggle_hidden_box('{{ ltid }}');">
                        <span id="hidden_box_{{ ltid }}_toggle_button" class="inline-icon-low-margin expand-more-icon" style="display: none;">

                        </span>
                        </a>
                    </h2>

                    <div id="hidden_box_{{ ltid }}" class="logical-box">
                        <ul class="collection-list">
                            {% if current_user.properties.messages %}
                                {% for prop_name, prop in current_user.properties.messages.properties %}
                                    {% set inline_node = prop %}
                                    {% set inline_node_path = "/graph/~" ~ current_user.id ~ "/messages/" ~ (prop_name | url_encode) %}
                                    <li>{{ include("Partials/NodeViews/Utilities/InlineNodeView.html.twig") }}</li>
                                {% else %}
                                    <li><em>No messages</em></li>
                                {% endfor %}
                            {% else %}
                                <li><em>No messages</em></li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
            <script>toggle_hidden_box("{{ ltid }}");toggle_hidden_box("{{ ltid }}");</script>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', async function() {
            const caseController = new CaseController();
            const casesListContainer = document.getElementById('cases-list-container');

            try {
                const allMyCases = await caseController.GetAllMyCases_DontDoThisLol();

                if (allMyCases && allMyCases.length > 0) {
                    casesListContainer.innerHTML = '';

                    allMyCases.forEach(caseItem => {
                        const li = document.createElement('li');
                        const link = document.createElement('a');

                        link.className = 'navigational-link';
                        link.href = `/cases/${caseItem.id}`;

                        const icon = document.createElement('span');
                        icon.className = 'inline-icon-shift-left inline-icon-low-margin cases-icon';
                        icon.title = '{{ "Case"|translate }}';

                        const textSpan = document.createElement('span');
                        textSpan.textContent = caseItem.title || `Case #${caseItem.id}`;

                        link.appendChild(icon);
                        link.appendChild(textSpan);
                        li.appendChild(link);
                        casesListContainer.appendChild(li);
                    });
                } else {
                    casesListContainer.innerHTML = '<li><em>{{ "No cases found"|translate }}</em></li>';
                }
            } catch (error) {
                console.error('Error loading cases:', error);
                casesListContainer.innerHTML = '<li><em>{{ "Error loading cases"|translate }}</em></li>';
            }
        });
    </script>
{% endblock %}
